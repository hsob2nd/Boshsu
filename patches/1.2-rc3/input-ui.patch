+void BackendApp::drawGameplayContents(Graphics* g) {
+    metricsBeginPhase(11);Osu::draw(g);metricsEndPhase(11);
+    if(showFPS_)drawShellFPS(g);
+    if(!showLivePP_ || !isInPlayMode() || !convar->getConVarByName("osu_draw_hud")->getBool())return;
+    metricsBeginPhase(10);
+    auto font=getSubTitleFont();auto skin=getSkin();
+    if(ppLabelWidth_<=0)ppLabelWidth_=font->getStringWidth(ppLabel_);
+    if(livePPReady_ && fcLabelWidth_<=0)fcLabelWidth_=font->getStringWidth(fcLabel_);
+    const float base=std::min<float>(hudScale_*ppScale_,(getScreenWidth()-24)/std::max(1.0f,ppLabelWidth_));
+    const float digitScale=getImageScale(this,skin->getScore0(),13)*base;
+    const float overlap=skin->getScoreOverlap()*(skin->isScore02x()?2:1);
+    const float numberWidth=livePPReady_?std::max(1.0f,(skin->getScore0()->getWidth()-overlap)*(ppDigits_+2)+skin->getScoreDot()->getWidth()-overlap)*digitScale:0;
+    const float textWidth=std::max(std::max(ppLabelWidth_*base,numberWidth),livePPReady_?fcLabelWidth_*base:0),textHeight=font->getHeight()*base;
+    const float x=ppPosition_>=2?std::max(12.0f,getScreenWidth()-12-textWidth):12;
+    const float scoreAnchor=getHUD()->getAccuracyBottom()+12;
+    const float desiredY=ppPosition_==0?getScreenHeight()-std::max(48.0,64*hudScale_):ppPosition_==3?getScreenHeight()/2.0f:(ppPosition_==1?50*hudScale_:scoreAnchor)+textHeight;
