+        public override void Update()
+        {
+            if(!headerDisposed && pendingHeaders!=null && pendingHeaders.IsCompleted){
+                var completedHeaders=pendingHeaders;var selected=headerMap;pendingHeaders=null;
+                if(ReferenceEquals(selected,BeatmapManager.Current)){
+                    if(completedHeaders.Status==System.Threading.Tasks.TaskStatus.RanToCompletion){
+                        selected.ProcessHeaders(completedHeaders.Result);forceNextSelection=true;headersJustApplied=true;
+                        try{beatmapTreeManager_OnSelectedBeatmap(this,selected);}finally{headersJustApplied=false;}
+                        if(playAfterHeaders){playAfterHeaders=false;Start();}
+                    }else{var error=completedHeaders.Exception;if(error!=null)NotificationManager.ShowMessage("Map preparation failed: "+error.GetBaseException().Message);playAfterHeaders=false;}
+                }else{var observed=completedHeaders.Exception;playAfterHeaders=false;}
+            }
+            if (GameBase.ActiveDialog != null)
+            {
+                wasDialogActive = true;
+                HandleInput = false;
+            }
+
+            if (!Starting)
