+        private void ScheduleNextBeatmapDifficultyCalculation()
+        {
+            Beatmap beatmap;
+            do
+            {
+                if (nextBeatmapToScheduleIndex < BeatmapManager.Beatmaps.Count)
+                {
+                    beatmap = BeatmapManager.Beatmaps[nextBeatmapToScheduleIndex];
+                    nextBeatmapToScheduleIndex++;
+                    continue;
+                }
+
+                if (BeatmapManager.BackgroundDifficultyCalculationNotificationShown && waitingBeatmaps.Count == 0)
+                {
+                    NotificationManager.ShowMessage("Background difficulty calculation finished.", Color.YellowGreen, 4000, null);
+                    BeatmapManager.BackgroundDifficultyCalculationNotificationShown = false;
+                }
+                return;
+            } while (!beatmap.RequiresDifficultyUpdate());
+
+            ScheduleBeatmapDifficultyCalculation(beatmap, 0);
+            if (waitingBeatmaps.Count > 50 && !BeatmapManager.BackgroundDifficultyCalculationNotificationShown)
+            {
+                NotificationManager.ShowMessage("Beatmap difficulty calculation is running in the background. Performance at song select may be lower than usual.");
+                BeatmapManager.BackgroundDifficultyCalculationNotificationShown = true;
+            }
+        }
+
+        internal void ScheduleBeatmapDifficultyCalculation(Beatmap beatmap, WorkItemPriority priority)
+        {
+            lock (waitingBeatmaps)
+            {
+                waitingBeatmaps.Add(beatmap.BeatmapId);
+            }
+
+            if (diffCalcText.Alpha == 0f)
+            {
+                diffCalcText.Show();
+                diffCalcText.Text = "Difficulty calculation in progress...";
+            }
+
+            beatmap.ComputeDifficultiesTomStarsBackground(difficultyCalculationThreadPool, priority, delegate
+            {
+                lock (waitingBeatmaps)
+                {
+                    waitingBeatmaps.Remove(beatmap.BeatmapId);
+                }
+
+                UpdateDiffCalcText();
+                if (beatmap == BeatmapManager.Current) UpdateDetails();
+            });
+        }
