+
+                    BeatmapManager.SongWatcher.EnableRaisingEvents = false;
+                    b.UpdateOsz2Container();
+
+                    b.Osz2ExtractSafe(Beatmap.CopyColissionMode.Ask, true);
+                    BeatmapManager.SongWatcher.EnableRaisingEvents = true;
+                }
+            }
+            catch (Exception)
+            {
+            }
+        }
