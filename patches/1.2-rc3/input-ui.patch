+        void beatmapTreeManager_OnSelectedBeatmap(object sender, Beatmap beatmap)
+        {
+            audioError = false; //reset state.
+
+            Beatmap oldMap = BeatmapManager.Current;
+
+            if (beatmap != null)
+                BeatmapManager.Current = beatmap;
+
+            bool isNewMap = oldMap != BeatmapManager.Current;
+
+            //Cancel previous requests to make room for current requests
+            //Also cancel when coming from Player as the score retrieval callback is different.
+            if (isNewMap || returningFromPlayMode)
+                oldMap?.CancelRequests();
+
+            //Cancel any pending scoreboard input handling
+            if (scoreList != null)
+            {
+                pSprite clickHandledSprite = SpriteManager.ClickHandledSprite;
+                if (clickHandledSprite != null && clickHandledSprite.Tag is Score)
+                    SpriteManager.ClickHandledSprite = null;
+            }
+
+            if (BeatmapManager.Current == null)
+                return;
+
+            if(pendingHeaders!=null && !ReferenceEquals(headerMap,BeatmapManager.Current) && BeatmapManager.Current.HeadersLoaded){
+                headerCancellation.Cancel();pendingHeaders.ContinueWith(t=>{var observed=t.Exception;},System.Threading.Tasks.TaskScheduler.Default);pendingHeaders=null;playAfterHeaders=false;
+            }
+
+            if(!BeatmapManager.Current.HeadersLoaded && BeatmapManager.Current.BeatmapPresent && !BeatmapManager.Current.InOszContainer){
+                if(!ReferenceEquals(headerMap,BeatmapManager.Current) || pendingHeaders==null){
+                    headerCancellation?.Cancel();headerCancellation?.Dispose();
+                    if(pendingHeaders!=null)pendingHeaders.ContinueWith(t=>{var observed=t.Exception;},System.Threading.Tasks.TaskScheduler.Default);
+                    headerCancellation=new CancellationTokenSource();headerMap=BeatmapManager.Current;playAfterHeaders=false;
+                    string path=headerMap.FilenameFull;
+                    AudioEngine.Stop();UpdateDetails();GameBase.TransitionManager.UpdateBackground();
+                    pendingHeaders=StableRemastered.Application.Shell.ShellWork.Run(token=>StableRemastered.Application.PreparedBeatmapHeaders.Read(path,token),headerCancellation.Token);
+                }
+                return;
+            }
+
+            if (isNewMap || forceNextSelection)
+            {
+                UpdateDetails();
+            }
+
+            bool needsBackgroundUpdate = true;
+            bool continuePlaying = !isNewMap && (!returningFromPlayMode || (AudioEngine.AudioTrack != null && AudioEngine.Time > 10000 && AudioEngine.Time < AudioEngine.AudioTrack.Length - 10000));
+            if(headersJustApplied)continuePlaying=false;
+
+            returningFromPlayMode = false;
+
+            if (!beatmapTreeManager.IsRandomActive && (isNewMap || forceNextSelection))
+            {
+                bool sameSet = oldMap != null && BeatmapManager.Current.SongSelectSetKey == oldMap.SongSelectSetKey;
+                if (sameSet && !forceNextSelection)
+                {
+                    // One visual set can contain independently baked audio.
+                    // Only physical resource siblings may continue a preview.
+                    continuePlaying = BeatmapManager.Current.SharesSongSelectResources(oldMap);
+                    AudioEngine.PlaySample(@"select-difficulty");
+                }
+                else
+                    AudioEngine.PlaySample(@"select-expand");
+
+                UpdateStatusIcon();
+
+                if (!BeatmapManager.Current.HeadersLoaded && BeatmapManager.Current.BeatmapPresent)
+                    if (!BeatmapManager.Current.ProcessHeaders())
+                    {
+                        //File was not found.
+                        BeatmapImport.ForceRun(false);
+                        return;
+                    }
+
+                if (!forceNextSelection && BeatmapManager.Current.SharesSongSelectResources(oldMap) && oldMap.BackgroundImage == BeatmapManager.Current.BackgroundImage)
+                    needsBackgroundUpdate = false;
+
+                try
+                {
+                    //Ensure we are playing from preview point when first entering the screen from play mode.
+                    BeginAudioTransition(BeatmapManager.Current, continuePlaying);
+                }
+                catch
+                {
+                    NotificationManager.ShowMessage(LocalisationManager.GetString(OsuString.SongSelection_AudioError));
+                    audioError = true;
+                }
+
+                forceNextSelection = false;
+
+                details.Transformations.Clear();
+                details.Alpha = 0;
+                details2.Transformations.Clear();
+                details2.Alpha = 0;
+                details3.Transformations.Clear();
+                details3.Alpha = 0;
+                details4.Transformations.Clear();
+                details4.Alpha = 0;
+                details5.Transformations.Clear();
+                details5.Alpha = 0;
+                details6.Transformations.Clear();
+                details6.Alpha = 0;
+
+                details.Transformations.Add(new Transformation(TransformationType.Fade, 0, 1, GameBase.Time, GameBase.Time + 400));
+                details2.Transformations.Add(new Transformation(TransformationType.Fade, 0, 1, GameBase.Time + 100, GameBase.Time + 500));
+                details3.Transformations.Add(new Transformation(TransformationType.Fade, 0, 1, GameBase.Time + 200, GameBase.Time + 600));
+                details4.Transformations.Add(new Transformation(TransformationType.Fade, 0, 1, GameBase.Time + 200, GameBase.Time + 700));
+                details5.Transformations.Add(new Transformation(TransformationType.Fade, 0, 1, GameBase.Time + 300, GameBase.Time + 800));
+                details6.Transformations.Add(new Transformation(TransformationType.Fade, 0, 1, GameBase.Time + 300, GameBase.Time + 800));
+
+                ShowScores();
+
+                whiteOverlay.Transformations.Clear();
+                whiteOverlay.Transformations.Add(new Transformation(TransformationType.Fade, 0.1f, 0, GameBase.Time, GameBase.Time + 500));
+
+                updateManiaSpeed(true);
+            }
+
+            if (needsBackgroundUpdate)
+                GameBase.TransitionManager.UpdateBackground();
+        }
