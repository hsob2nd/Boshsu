+void BackendApp::drawShellFPS(Graphics* g) {
+    if(!shellFont_ || !shellFont_->isReady())return;
+    const double now=engine->getTime();
+    if(previousPresent_>0 && now>=previousPresent_){fpsSeconds_+=now-previousPresent_;fpsFrames_++;}
+    previousPresent_=now;
+    if(engine->getTime()>=nextFpsText_){
+        const double mean=fpsSeconds_/std::max(1u,fpsFrames_);
+        fpsText_=UString::format("%.0f fps",mean>0?1/mean:0);frameText_=UString::format("%.2f ms",mean*1000);
+        fpsSeconds_=0;fpsFrames_=0;nextFpsText_=engine->getTime()+.25;
+    }
+    // Match the small shell counter in physical pixels, independently of HUD
+    // scale / playfield letterboxing. Font and geometry are prepared once.
+    const float sx=fpsDpi_/presentationScaleX(),sy=fpsDpi_/presentationScaleY();
+    const float x=getScreenWidth()-88*sx,y=getScreenHeight()-36*sy;
+    g->pushTransform();g->scale(sx,sy);g->translate(x,y);
+    g->setColor(0xcc17172b);g->fillRect(0,0,84,32);
+    g->setColor(0xff73e5ef);g->fillRect(0,0,2,32);
+    g->setColor(0xffedf2f9);g->pushTransform();g->translate(8,13);g->drawString(shellFont_,fpsText_);g->popTransform();
