+        private bool CheckHasPlayable()
+        {
+            if (BeatmapManager.Beatmaps.Count == 0 || (PlayMode && BeatmapManager.Beatmaps.Count - BeatmapManager.TotalAudioOnly == 0))
+            {
+                exiting = true;
+
+                if ((BanchoClient.Permission & Permissions.Supporter) > 0)
+                    GameBase.ChangeMode(OsuModes.OnlineSelection);
+                else
+                {
+                    int delay = 5000;
+
+                    NotificationManager.ShowMessageMassive(LocalisationManager.GetString(OsuString.SongSelection_NoBeatmaps), delay);
+
+                    GameBase.Scheduler.AddDelayed(delegate { GameBase.ProcessStart(ServerSwitcher.getFrontEnd + @"/?p=beatmaplist"); }, delay / 2);
+                    GameBase.Scheduler.AddDelayed(delegate { GameBase.ChangeMode(OsuModes.Menu); }, delay);
+                }
+                return false;
+            }
+
+            return true;
+        }
