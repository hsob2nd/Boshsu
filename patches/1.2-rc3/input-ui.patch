+        void UpdateDifficulty(object sender, EventArgs e)
+        {
+            pSprite s = (pSprite)sender;
+            s.Transformations.Add(new Transformation(TransformationType.Fade, 1, 0.2F, GameBase.Time, GameBase.Time + 400));
+
+            pSprite tag = s.Tag as pSprite;
+            if (tag != null)
+            {
+                tag.Transformations[0] = tag.Transformations[0].CloneReverse();
+                tag.Transformations[1] = tag.Transformations[1].CloneReverse();
+            }
+            s.HandleInput = false;
+
+            Beatmap b = BeatmapManager.Current;
+
+            try
+            {
+                if (!b.InOszContainer)
+                {
+                    //check it matches the downloadable copy
+                    newBeatmapName = b.Filename + @"_";
+                    pFileWebRequest request = new pFileWebRequest(string.Format(@"{0}/{1}_", b.ContainingFolderAbsolute, b.Filename), Urls.PATH_MAPS + Path.GetFileName(b.Filename.Replace(@"#", @"%23")));
+                    request.Finished += delegate (pWebRequest r, Exception e1)
+                    {
+                        if (e1 == null)
+                        {
+                            GameBase.Scheduler.Add(delegate { b.ReplaceWithUpdate(); });
+                        }
+                        else
+                        {
+                            try
+                            {
+                                File.Delete(newBeatmapName);
+                            }
+                            catch
+                            {
+                            }
+                        }
+                        DownloadFinished(e == null);
+                    };
+                    BeatmapManager.SongWatcher.EnableRaisingEvents = false;
+                    request.Perform();
+                }
+                else
+                {
+                    pWebRequest request = new pWebRequest(Urls.PATH_MAPS + Path.GetFileName(b.Filename.Replace(@"#", @"%23")));
