+    if(livePPReady_) {
+        g->pushTransform();g->scale(digitScale,digitScale);g->translate(x,y+skin->getScore0()->getHeight()*digitScale*.75f);
+        getHUD()->drawScoreNumber(g,ppInteger_,digitScale,false);
