+void BackendApp::draw(Graphics* g) {
+    const bool corrected=gamma_&&gamma_->active()&&isInPlayMode();
+    if(corrected){metricsBeginPhase(24);gamma_->begin();metricsEndPhase(24);}
+    try {drawGameplayContents(g);}catch(...){if(corrected)gamma_->finish(g);throw;}
+    if(corrected){metricsBeginPhase(24);gamma_->finish(g);metricsEndPhase(24);}
