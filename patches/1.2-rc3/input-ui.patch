+                    details5.ToolTip=state==null?error:"Rated map difficulty. Gameplay CS: "+state.Runtime.GameplayCS.ToString("0.##")+". Personal reading AR is a separate assistance setting.";
+                    details6.Text=state==null?"Rated stars unavailable":(state.Generated?"Map Lab "+state.MapLabRatedSpeed.ToString("0.##")+"x • ":"")+"TW "+state.PlaybackRate.ToString("0.##")+"x • "+state.EffectiveBPM.ToString("0.##")+" BPM • "+((int)(state.DurationSeconds/60))+":"+((int)state.DurationSeconds%60).ToString("D2");
