+using System;
+using System.IO;
+using System.Diagnostics;
+using System.Windows.Forms;
+using Newtonsoft.Json;
+using StableRemastered.Updates;
+class BoshsuUpdater
+{
+    [STAThread]static int Main(string[] args)
+    {
+        UpdateJob job=null;bool restart=false;
+        try{
+            if(args.Length!=1||Path.GetFullPath(args[0])!=Path.Combine(AppDomain.CurrentDomain.BaseDirectory,"job.json"))return 2;
+            job=JsonConvert.DeserializeObject<UpdateJob>(File.ReadAllText(args[0]));
+            try{using(var parent=Process.GetProcessById(job.ParentId))if(!parent.WaitForExit(120000))throw new IOException("Boshsu is still running. The update was not applied.");}catch(ArgumentException){}
+            ClientUpdatePackage.Install(job);restart=true;
+            File.WriteAllText(Path.Combine(job.Root,"Updates","last-update.txt"),"Installed "+job.Tag+" at "+DateTime.UtcNow.ToString("O"));return 0;
+        }catch(Exception error){
+            if(job!=null)try{File.WriteAllText(Path.Combine(job.Root,"Updates","last-update.txt"),error.ToString());}catch{}
+            MessageBox.Show("The update could not finish. Existing files were restored where possible. See Updates/last-update.txt and the rollback folder.\n\n"+error.Message,"Boshsu update",MessageBoxButtons.OK,MessageBoxIcon.Error);return 1;
+        }finally{if(restart)try{Process.Start(new ProcessStartInfo(Path.Combine(job.Root,"Boshsu.exe")){WorkingDirectory=job.Root});}catch{}}
+    }
+}
