+        CancellationTokenSource cancel;Task worker;volatile ClientUpdateStatus status=new ClientUpdateStatus();
+        bool closed,startupChecked;string downloaded;UpdateJob install;readonly Stopwatch startup=Stopwatch.StartNew();
+        internal UpdatePreferences Preferences{get;private set;}=new UpdatePreferences();
+        internal ClientUpdateStatus Status=>status;
+        internal GithubClientUpdates(string root)
+        {
+            this.root=Path.GetFullPath(root);folder=Path.Combine(this.root,"Updates");
+            try{var p=Path.Combine(folder,"preferences.json");if(File.Exists(p))Preferences=JsonConvert.DeserializeObject<UpdatePreferences>(File.ReadAllText(p))??new UpdatePreferences();}catch{}
+            http=new HttpClient{Timeout=TimeSpan.FromMinutes(10)};http.DefaultRequestHeaders.UserAgent.ParseAdd("Boshsu/1.2");http.DefaultRequestHeaders.Accept.ParseAdd("application/vnd.github+json");
+        }
+        internal void SavePreferences(bool startupCheck,bool betas)
+        {
+            var p=new UpdatePreferences{CheckOnStartup=startupCheck,IncludeBetas=betas};Directory.CreateDirectory(folder);File.WriteAllText(Path.Combine(folder,"preferences.json"),JsonConvert.SerializeObject(p));Preferences=p;
+        }
+        internal void Tick()
+        {
+            if(startupChecked||!Preferences.CheckOnStartup||startup.Elapsed.TotalSeconds<8||osu.GameBase.Mode!=osu.OsuModes.Menu)return;
+            startupChecked=true;Check();
+        }
+        internal void Check()=>Run(async token=>{
+            status=new ClientUpdateStatus{State="Checking",Message="Checking GitHub releases…"};
+            using(var timeout=CancellationTokenSource.CreateLinkedTokenSource(token)){
+                timeout.CancelAfter(TimeSpan.FromSeconds(25));using(var r=await http.GetAsync("https://api.github.com/repos/"+ClientRelease.Repository+"/releases?per_page=20",timeout.Token).ConfigureAwait(false)){
+                    r.EnsureSuccessStatusCode();if(r.Content.Headers.ContentLength>2*1024*1024)throw new InvalidDataException("Release list is too large.");
+                    string text=await r.Content.ReadAsStringAsync().ConfigureAwait(false);if(text.Length>2*1024*1024)throw new InvalidDataException("Release list is too large.");
