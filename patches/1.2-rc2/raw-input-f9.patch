+                string tag=(string)r["tag_name"];if((bool?)r["draft"]==true||!betas&&(bool?)r["prerelease"]==true)continue;
+                try{if(ClientRelease.Compare(tag,ClientRelease.Tag)<=0||best!=null&&ClientRelease.Compare(tag,best.Tag)<=0)continue;}catch{continue;}
+                var a=(r["assets"] as JArray)?.OfType<JObject>().FirstOrDefault(x=>ClientRelease.AllowedDownload((string)x["browser_download_url"],tag,(string)x["name"]));
+                string digest=(string)a?["digest"];long size=(long?)a?["size"]??0;
+                if(a==null||size<1||size>1024L*1024*1024||!Regex.IsMatch(digest??"",@"^sha256:[0-9a-f]{64}$"))continue;
+                best=new ClientUpdateStatus{State="Available",Message="A newer client is available.",Tag=tag,Url=(string)a["browser_download_url"],Name=(string)a["name"],Hash=digest.Substring(7),Bytes=size};
+            }
+            return best??new ClientUpdateStatus{State="Current",Message=betas?"You are on the newest available client in this channel.":"No newer stable release. Enable beta updates for release candidates."};
+        }
+        internal void Download()
+        {
+            var release=status;if(release.State!="Available")return;
