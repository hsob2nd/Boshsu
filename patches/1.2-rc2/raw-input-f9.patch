+using System.Text.RegularExpressions;
+using Newtonsoft.Json;
+using Newtonsoft.Json.Linq;
+using StableRemastered.Updates;
+namespace StableRemastered.Application.Updates
+{
+    internal sealed class UpdatePreferences {public bool CheckOnStartup=true,IncludeBetas=true;}
+    internal sealed class ClientUpdateStatus
+    {
+        public string State="Idle",Message="Check GitHub for a newer client.",Tag,Url,Name,Hash;
+        public long Bytes,Received;
+        public double Progress=>Bytes>0?Math.Min(1,(double)Received/Bytes):0;
+        public bool Busy=>State=="Checking"||State=="Downloading";
+    }
+    internal sealed class GithubClientUpdates : IDisposable
+    {
