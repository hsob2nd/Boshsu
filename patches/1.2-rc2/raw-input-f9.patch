+                }finally{if(File.Exists(part))try{File.Delete(part);}catch{}}
+            });
+        }
+        static ClientUpdateStatus Copy(ClientUpdateStatus s,string state,string message,long received)=>new ClientUpdateStatus{State=state,Message=message,Tag=s.Tag,Url=s.Url,Name=s.Name,Hash=s.Hash,Bytes=s.Bytes,Received=received};
