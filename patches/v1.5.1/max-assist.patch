+void BackendApp::onPlayEnd(bool quit) {
+    resetApplicationDeveloperState();
+    gameplayPointerOwned=false;
+    terminalState_=quit?7:beatmap_->hasFailed()?5:6;
+    getInputExtension()->ending(beatmap_.get(),quit?3:beatmap_->hasFailed()?2:1);
