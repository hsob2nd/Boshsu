+void strength15(HostedModel& model,std::ofstream& r){
+    r<<"\"StrengthComparison\":[";bool first=true;
+    for(int pattern=0;pattern<4;pattern++){
+        double baseline=0;
+        for(double boost:{1.,1.1,1.25}){
+            targets={circle(1000,400)};Collection objects;objects.values={head(1000,400)};Settings ac;MaxAssistV2 guide;model.reset();ModelFrame m;m.owner=owner;m.flags=1;m.count=1;m.intensity=.5;m.hitRadius=22;m.hitWindow50=100;m.approachTime=500;Point out;
+            for(int t=500;t<=1000;t++){
+                double u=(t-500)/500.;m.mapMilliseconds=t;m.realMilliseconds=10000+t;m.rawX=50+u*(pattern==0?330:pattern==1?250:pattern==2?370:180);m.rawY=100+std::sin(u*3.141592653589793)*(pattern==0?35:pattern==1?120:pattern==2?-60:5);
+                ModelOutput o;check15(model.process(m,o),"Planner unavailable");auto f=f15(t,Point(m.rawX,m.rawY));Point plan(m.rawX+(o.blendedX-m.rawX)*boost,m.rawY+(o.blendedY-m.rawY)*boost);out=o.hasRequested?guide.process(f,plan,.5,ac,objects,o.targetIndex,500,2,2,boost):f.input;check15(finite(out),"Boost produced nonfinite cursor");++samples15;
+            }
+            double error=std::sqrt(distance2(out,Point(400,100)));if(boost==1)baseline=error;
+            if(!first)r<<',';first=false;r<<"{\"Pattern\":"<<pattern<<",\"Strength\":"<<boost<<",\"EndpointError\":"<<error<<'}';
+            if(boost>1)check15(error<=baseline+1e-8,"Higher strength worsened endpoint in comparison");
+        }
+    }r<<"],";
+    // Identical physical paths at common map timestamps; extra polls buy no gain.
+    Collection objects;objects.values={head(1000,400)};Settings ac;
+    for(double boost:{1.,1.1,1.25})for(double rate:{1.,1.17,1.5,2.}){
+        Point reference;bool have=false;
+        for(int hz:{60,120,144,240,360,1000,4000}){
+            MaxAssistV2 guide;guide.process(f15(500,Point(50,100)),Point(200,100),.5,ac,objects,0,500,2,2,boost);Point out;int previous=500;
+            for(int n=1;;n++){int t=std::min(1000,500+int(n*1000.*rate/hz));if(t<=previous)continue;auto f=f15(t,Point(50+(t-500)*.5,100));out=guide.process(f,Point(200+(t-500)*.3,100),.5,ac,objects,0,500,2,2,boost);auto same=guide.process(f,Point(500,200),.5,ac,objects,0,500,2,2,boost);check15(distance2(out,same)==0,"Extra callback bought strength");previous=t;if(t==1000)break;}
+            if(have)check15(distance2(reference,out)<1e-12,"Boost depends on render rate");reference=out;have=true;
+        }
+    }
+}
