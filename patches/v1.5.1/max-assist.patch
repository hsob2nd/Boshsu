+void BackendApp::draw(Graphics* g) {
+    const bool corrected=gamma_&&gamma_->active()&&isInPlayMode();
+    if(corrected){metricsBeginPhase(24);gamma_->begin();metricsEndPhase(24);}
+    try {drawGameplayContents(g);}catch(...){if(corrected)gamma_->finish(g);throw;}
+    if(corrected){metricsBeginPhase(24);gamma_->finish(g);metricsEndPhase(24);}
+}
+void BackendApp::drawGameplayContents(Graphics* g) {
+    metricsBeginPhase(11);Osu::draw(g);metricsEndPhase(11);
+    if(showFPS_)drawShellFPS(g);
+    if(!showLivePP_ || !isInPlayMode() || !convar->getConVarByName("osu_draw_hud")->getBool())return;
+    metricsBeginPhase(10);
+    auto font=getSubTitleFont();auto skin=getSkin();
+    if(ppLabelWidth_<=0)ppLabelWidth_=font->getStringWidth(ppLabel_);
+    if(livePPReady_ && fcLabelWidth_<=0)fcLabelWidth_=font->getStringWidth(fcLabel_);
+    const float base=std::min<float>(hudScale_*ppScale_,(getScreenWidth()-24)/std::max(1.0f,ppLabelWidth_));
+    const float digitScale=getImageScale(this,skin->getScore0(),13)*base;
+    const float overlap=skin->getScoreOverlap()*(skin->isScore02x()?2:1);
+    const float numberWidth=livePPReady_?std::max(1.0f,(skin->getScore0()->getWidth()-overlap)*(ppDigits_+2)+skin->getScoreDot()->getWidth()-overlap)*digitScale:0;
+    const float textWidth=std::max(std::max(ppLabelWidth_*base,numberWidth),livePPReady_?fcLabelWidth_*base:0),textHeight=font->getHeight()*base;
+    const float x=ppPosition_>=2?std::max(12.0f,getScreenWidth()-12-textWidth):12;
+    const float scoreAnchor=getHUD()->getAccuracyBottom()+12;
+    const float desiredY=ppPosition_==0?getScreenHeight()-std::max(48.0,64*hudScale_):ppPosition_==3?getScreenHeight()/2.0f:(ppPosition_==1?50*hudScale_:scoreAnchor)+textHeight;
+    const float y=std::max(textHeight,std::min<float>(desiredY,getScreenHeight()-12-skin->getScore0()->getHeight()*digitScale-textHeight*2.3f));
+    g->setColor(0xffffffff);g->pushTransform();g->scale(base,base);g->translate(x,y);g->drawString(font,ppLabel_);g->popTransform();
+    if(livePPReady_) {
+        g->pushTransform();g->scale(digitScale,digitScale);g->translate(x,y+skin->getScore0()->getHeight()*digitScale*.75f);
+        getHUD()->drawScoreNumber(g,ppInteger_,digitScale,false);
+        if(skin->getScoreDot()!=skin->getMissingTexture()) {
+            g->translate(skin->getScoreDot()->getWidth()*.5f*digitScale,0);g->drawImage(skin->getScoreDot());
+            g->translate((skin->getScoreDot()->getWidth()*.5f-overlap)*digitScale,0);
+        }
+        getHUD()->drawScoreNumber(g,ppFraction_,digitScale,true);g->popTransform();
+        g->setColor(0xffc1b8df);g->pushTransform();g->scale(base,base);g->translate(x,y+skin->getScore0()->getHeight()*digitScale+textHeight*1.3f);g->drawString(font,fcLabel_);g->popTransform();
+    }
+    metricsEndPhase(10);
+}
+void BackendApp::drawGameplayVisibility(Graphics* g) {
+    auto map=dynamic_cast<OsuBeatmapStandard*>(getSelectedBeatmap());
+    if(!getModFlashlight()||!map||map->isLoading()||map->isPaused()||map->hasFailed()){flashlight_.reset();return;}
+    const auto cursor=map->getCursorPos();
+    flashlight_.update(engine->getTime(),cursor.x,cursor.y,getScore()->getCombo(),map->isInBreak());
+    if(!flashlight_.initialized)return;
+    const float width=getScreenWidth(),height=getScreenHeight();
+    const Vector2 center((float)flashlight_.x,(float)flashlight_.y);
+    const float radius=(float)flashlight_.radius(height),inner=radius*.85f;
+    const float outerRadius=std::hypot(width,height)+std::hypot(center.x,center.y)+radius;
+    static const auto points=[](){std::array<Vector2,129> out;for(unsigned i=0;i<out.size();i++){double angle=i*6.2831853071795864769/128;out[i]=Vector2((float)std::cos(angle),(float)std::sin(angle));}return out;}();
+    g->setColor(0xffffffff);
+    unsigned vertex=0;
+    for(unsigned i=0;i<128;i++){
+        auto a=points[i],b=points[i+1];
+        for(auto point:{center+a*inner,center+b*inner,center+b*radius,center+a*radius,center+a*radius,center+b*radius,center+b*outerRadius,center+a*outerRadius})flashlightMesh_->setVertex(vertex++,point);
+    }
+    g->drawVAO(flashlightMesh_.get());
+    if(map->isFlashlightSliderTracking()&&!map->isInBreak()){g->setColor(0xcc000000);g->fillRect(0,0,width,height);}
+    g->setColor(0xffffffff);
+}
+void BackendApp::drawShellFPS(Graphics* g) {
+    if(!shellFont_ || !shellFont_->isReady())return;
+    const double now=engine->getTime();
+    if(previousPresent_>0 && now>=previousPresent_){fpsSeconds_+=now-previousPresent_;fpsFrames_++;}
+    previousPresent_=now;
+    if(engine->getTime()>=nextFpsText_){
+        const double mean=fpsSeconds_/std::max(1u,fpsFrames_);
+        fpsText_=UString::format("%.0f fps",mean>0?1/mean:0);frameText_=UString::format("%.2f ms",mean*1000);
+        fpsSeconds_=0;fpsFrames_=0;nextFpsText_=engine->getTime()+.25;
+    }
+    // Match the small shell counter in physical pixels, independently of HUD
+    // scale / playfield letterboxing. Font and geometry are prepared once.
+    const float sx=fpsDpi_/presentationScaleX(),sy=fpsDpi_/presentationScaleY();
+    const float x=getScreenWidth()-88*sx,y=getScreenHeight()-36*sy;
+    g->pushTransform();g->scale(sx,sy);g->translate(x,y);
+    g->setColor(0xcc17172b);g->fillRect(0,0,84,32);
+    g->setColor(0xff73e5ef);g->fillRect(0,0,2,32);
+    g->setColor(0xffedf2f9);g->pushTransform();g->translate(8,13);g->drawString(shellFont_,fpsText_);g->popTransform();
+    g->setColor(0xffa1b3c9);g->pushTransform();g->translate(8,27);g->drawString(shellFont_,frameText_);g->popTransform();g->popTransform();
+}
