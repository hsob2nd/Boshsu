+void BackendApp::onKeyDown(KeyboardEvent& key) {
+    if(key==VK_ESCAPE || key==(KEYCODE)OsuKeyBindings::GAME_PAUSE.getInt()) {
+        if(!pauseHeld_) {pauseHeld_=true;apply("{\"Command\":\"TogglePause\"}");}
+        key.consume();return;
+    }
+    Osu::onKeyDown(key);
+}
+void BackendApp::onKeyUp(KeyboardEvent& key) {
+    if(key==VK_ESCAPE || key==(KEYCODE)OsuKeyBindings::GAME_PAUSE.getInt())pauseHeld_=false;
+    Osu::onKeyUp(key);
+}
+void BackendApp::onLeftChange(bool down) {
+    if(beatmap_ && beatmap_->isContinueScheduled()) {
+        if(down) {
+            auto standard=dynamic_cast<OsuBeatmapStandard*>(beatmap_.get());
+            const Vector2 pointer=engine->getEnvironment()->getMousePos();
+            if(standard && (pointer-getHUD()->getVisibleContinuePoint(standard->getContinueCursorPoint())).length()<=standard->getHitcircleDiameter()/2)
+                beatmap_->continueFromApplicationPointer();
+        }
+        return; // This is UI confirmation; it does not generate a hit/button edge.
+    }
+    Osu::onLeftChange(down);
+}
