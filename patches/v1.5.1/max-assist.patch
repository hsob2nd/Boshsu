+int __cdecl readModelTarget(std::uint64_t owner,int index,int mapTime,TargetInfo* out) {
+    if(!readMap || !out || owner!=readOwner || GetCurrentThreadId()!=readThread || index<0 ||
+       std::size_t(index)>=readMap->getHitObjectsPointer().size()) return 0;
+    auto object=readMap->getHitObjectsPointer()[index];
+    const std::int64_t end=std::int64_t(object->getTime())+object->getDuration();
+    if(end>std::numeric_limits<int>::max() || end<std::numeric_limits<int>::min()) return 0;
+    const Vector2 head=object->getRawPosAt(object->getTime());
+    const Vector2 path=object->getRawPosAt(std::max(object->getTime(),std::min(long(mapTime),long(end))));
+    const Vector2 tail=object->getRawPosAt(long(end));
