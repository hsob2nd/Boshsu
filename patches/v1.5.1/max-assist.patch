+void BackendApp::saveAttempt(const char* eventType,bool quit) {
+    metricsActive(false);metricsSave(eventType);
+    saveHealthReceipt();
+    auto nativeResults=static_cast<ultimate::gameplay::NativeResults*>(getResultExtension());
+    nativeResults->applicationAttempt(attemptIdentity_);
+    getResultExtension()->completed(beatmap_.get(),quit);
+    const auto& replay=nativeResults->recordingDiagnostics();
+    const auto& result=static_cast<ultimate::gameplay::NativeResults*>(getResultExtension())->result();
+    emit({{"Type",eventType},{"Result",{
+        {"BeatmapMD5",result.mapHash},{"AttemptIdentity",attemptIdentity_},{"Mode",0},{"ModBits",stableMods_},{"Score",result.score},
+        {"Count300",result.n300},{"Count100",result.n100},{"Count50",result.n50},{"CountMiss",result.misses},
+        {"CountGeki",result.geki},{"CountKatu",result.katu},{"MaxCombo",result.maxCombo},{"CurrentCombo",result.combo},
+        {"Perfect",result.maxCombo==result.fullCombo && result.misses==0},{"FinalHealth",beatmap_->getHealth()},{"ObservedAssistance",getGameplayContext().assisted},
+        {"Completion",beatmap_->hasFailed()?1:quit?2:result.passed?0:1},{"ReplayPath",result.replayReference},
+        {"ReplayDiagnostics",{{"Requested",replay.requested},{"Eligible",replay.eligible},{"FrameCount",replay.frames},{"Reason",replay.reason},{"SavePath",replay.path},{"WriterState",replay.state},{"Associated",!result.replayReference.empty()}}},
+        {"AssistLearning",Json::parse(getInputExtension()->learningSummary())},{"ScoreAlgorithm","McOsu native; stable equivalence unverified"},{"CompatibilityCertificate",nullptr},
+        {"TimestampUnix",result.unixTimestamp}}}});
+}
+void BackendApp::publishReplaySaves(){
