+void NativeInput::judgment(OsuBeatmap* base,OsuHitObject* object,int grade,long delta) {
+    if(!diagnostics_.enabled())return;
+    auto map=dynamic_cast<OsuBeatmapStandard*>(base);if(!map)return;
+    if(osu_->isLocalReplay()) {
+        const std::string& hash=map->getSelectedDifficulty2()->getMD5Hash();
+        if(!replayRun_ || lastMap_!=map || lastHash_!=hash || map->getCurMusicPosWithOffsets()<lastTime_) {
+            diagnostics_.endRun(run_);run_++;replayRun_=true;lastMap_=map;lastHash_=hash;
+        }
+        lastTime_=map->getCurMusicPosWithOffsets();
+    }
+    const auto& all=map->getHitObjectsPointer();int index=-1;
+    if(object) {
+        auto begin=std::lower_bound(all.begin(),all.end(),object->getTime(),[](OsuHitObject* a,long t){return a->getTime()<t;});
+        for(unsigned n=0;begin!=all.end() && (*begin)->getTime()==object->getTime() && n<256;++begin,++n)
+            if(*begin==object) {index=int(begin-all.begin());break;}
+    }
+    DiagnosticEvent e=frameObserved_?lastEvent_:DiagnosticEvent();
+    e.run=metadataActive_?metadataRun_:run_;e.object=index;e.grade=grade;e.timingError=delta;e.lastMap=map->getCurMusicPosWithOffsets();e.combo=osu_->getScore()->getCombo();
+    if(osu_->isLocalReplay()) {e.flags|=128;e.acReason=unsigned(Reason::Replay);e.relaxReason=8;}
+    Vector2 logical;if(map->displayToCanonical(map->getCursorPos(),logical)) {e.corrected=point(logical);e.flags|=64;}
+    diagnostics_.judgment(e);
+}
+bool NativeInput::deferFailure(OsuBeatmap* base) {
+    if(!hpProtection.getBool() || !osu_->getGameplayPolicy().assistAllowed() || osu_->isLocalReplay() || !base->isPlaying() || base->isPaused() || base->hasFailed()) return false;
+    auto map=dynamic_cast<OsuBeatmapStandard*>(base);if(!map || osu_->isInVRMode()) return false;
+    const long now=map->getCurMusicPosWithOffsets();const auto& all=map->getHitObjectsPointer();
+    OsuHitObject* last=nullptr;
+    for(auto obj:all) {
+        if(obj->getTime()>now) break;
+        last=obj;
+        if(auto slider=dynamic_cast<OsuSlider*>(obj))
+            if(sliderProtection.getBool() && !slider->isFinished() && now<obj->getTime()+obj->getDuration() && slider->isTrackingNative()) {osu_->noteAssistedInput();return true;}
+        if(auto spinner=dynamic_cast<OsuSpinner*>(obj)) {
+            const bool moving=std::isfinite(spinner->getCurrentRPM()) && std::abs(spinner->getCurrentRPM())>0;
+            if(spinnerProtection.getBool() && !spinner->isFinished() && now<obj->getTime()+obj->getDuration() && moving) {osu_->noteAssistedInput();return true;}
+        }
+    }
+    auto spinner=dynamic_cast<OsuSpinner*>(last);
+    const bool protect=spinnerProtection.getBool() && spinner && now>=last->getTime()+last->getDuration() &&
+           (spinner->getRotationCount()>0 || (std::isfinite(spinner->getCurrentRPM()) && std::abs(spinner->getCurrentRPM())>0));
+    if(protect)osu_->noteAssistedInput();return protect;
+}
