+    subprocess.run([str(v) for v in [tool/'g++.exe','-std=c++11','-O2','-shared','-static-libgcc','-static-libstdc++','-I'+str(r/'engine/mcosu/ultimate'),r/'tests/V15MaxAssist.cpp',source/'InputCoordinator.cpp',source/'HostedModel.cpp','-o',dll,'-lole32']],check=True)
+    with os.add_dll_directory(str(tool)):
