+extern "C" __declspec(dllexport) int sr_sensitivity(const char* assembly,const char* data,const char* path){
+    std::ofstream report(path);report<<"pattern,setting,value,planned_delta,final_delta,endpoint_error\n";
+    try{
+        HostedModel model;if(!model.initialize(wide(assembly),wide(data),read,true))return 2;
+        for(int pattern=0;pattern<4;pattern++){
+            std::vector<Point> planBase,outBase;
+            for(int setting=-1;setting<5;setting++)for(int value=0;value<(setting<0?1:2);value++){
+                targets={circle(1000,400),circle(1250,100)};Collection objects;objects.values={head(1000,400),head(1250,100)};
+                model.reset();MaxAssistV2 guide;Settings ac;ModelFrame m;m.owner=owner;m.flags=1;m.intensity=.5;m.count=2;m.hitRadius=22;m.hitWindow50=100;m.approachTime=500;
+                double* knob=setting==0?&m.goldenStyle:setting==1?&m.directness:setting==2?&m.precision:setting==3?&m.timingPriority:&m.inputIntent;
+                if(setting>=0)*knob=setting==4?(value?1:.25):value;
+                double pd=0,fd=0,error=0;int n=0;
+                for(int t=500;t<=1000;t++,n++){
+                    double u=(t-500)/500.;m.mapMilliseconds=t;m.realMilliseconds=10000+t;m.rawX=50+u*(pattern==0?330:pattern==1?250:pattern==2?370:180);m.rawY=100+std::sin(u*3.141592653589793)*(pattern==0?35:pattern==1?120:pattern==2?-60:5);
+                    ModelOutput o;if(!model.process(m,o))throw std::runtime_error("planner failed");
+                    Point plan(o.requestedX,o.requestedY),out(m.rawX,m.rawY);Frame f;f.owner=owner;f.active=true;f.map=t;f.hitRadius=22;f.hitWindow50=100;f.input=out;
+                    if(o.hasRequested)out=guide.process(f,Point(o.blendedX,o.blendedY),.5,ac,objects,o.targetIndex,500,2,2);
+                    if(setting<0){planBase.push_back(plan);outBase.push_back(out);}else{pd+=std::sqrt(distance2(plan,planBase[n]));fd+=std::sqrt(distance2(out,outBase[n]));}
+                    if(t==1000)error=std::sqrt(distance2(out,Point(400,100)));
+                }
+                report<<pattern<<','<<setting<<','<<value<<','<<pd/n<<','<<fd/n<<','<<error<<'\n';
+            }
+        }return 0;
+    }catch(const std::exception& e){report<<"ERROR,"<<e.what();return 1;}
+}
