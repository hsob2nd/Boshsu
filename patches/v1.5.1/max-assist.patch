+        emit({{"Type","ReplaySaved"},{"AttemptIdentity",saved.attempt},{"ReplayPath",saved.saved?saved.reference:""},
+            {"ReplayDiagnostics",{{"Requested",true},{"Eligible",true},{"FrameCount",saved.frames},{"SavePath",saved.path},
+              {"WriterState",saved.saved?"Saved":"Failed"},{"Reason",saved.error},{"Associated",saved.saved}}}});
