+Json appliedSettings;
+void setting(const char* name,double value) {
+    auto variable=convar->getConVarByName(name,false);
+    if(!variable)throw std::runtime_error(std::string("Missing engine setting: ")+name);
+    variable->setValue(static_cast<float>(value));
+    appliedSettings[name]=variable->getFloat();
+}
+}
+BackendApp::BackendApp() : Osu(nullptr,0,true) {
+    setResultExtension(new ultimate::gameplay::NativeResults(this));
+    setInputExtension(new BridgeInput(this));
+    // Native configuration cannot initiate legacy online identity or shell navigation.
+    setting("osu_pause_on_focus_loss",0);
+    setting("osu_win_disable_windows_key_while_playing",0);
+    // GameplayMapClock owns interpolation. Sound's startup blend resets its
+    // wall anchor on Resume and can report near-zero at an actual 400ms position.
+    setting("snd_play_interp_duration",0);
+    setting("osu_draw_fps",0);
+    shellFont_=engine->getResourceManager()->loadFont("Barlow-Regular.ttf","FONT_BOSH_COUNTER",9,true,96);
+    gamma_.reset(new GameplayGamma(engine->getResourceManager()));
+    flashlightMesh_.reset(new VertexArrayObject(Graphics::PRIMITIVE::PRIMITIVE_QUADS));
+    for(unsigned i=0;i<1024;i++){flashlightMesh_->addVertex(0,0);flashlightMesh_->addColor(i%8<2?0x00000000:0xff000000);}
+    ready();
+}
+BackendApp::~BackendApp() {
+    if(beatmap_)beatmap_->unloadMusic();
+    beatmap_.reset();difficulty_.reset();
+    auto results=getResultExtension();setResultExtension(nullptr);delete results;
+    auto input=getInputExtension();setInputExtension(nullptr);delete input;
+}
+void BackendApp::update() {
+    engine->getResourceManager()->setNumResourceInitPerFrameLimit(startPending_ || !pendingSkin_.empty() || isSkinLoading()?32:1);
+    if(!(GetAsyncKeyState(OsuKeyBindings::GAME_PAUSE.getInt()) & 0x8000) && !(GetAsyncKeyState(VK_ESCAPE) & 0x8000))pauseHeld_=false;
+    for(const auto& command:takeCommands()) {
+        try { apply(command.dump()); }
+        catch(const std::exception& error) {faulted_=true;publish({{"State",8},{"Error",error.what()}});emit({{"Type","Fault"},{"Error",error.what()}});break;}
+    }
+    publishReplaySaves();
+    metricsBeginPhase(4);Osu::update();metricsEndPhase(4);
+    if(beatmap_ && spinnerTrace.count) {
+        auto sample=spinnerTrace.samples[spinnerTrace.count-1];const auto time=beatmap_->getCurMusicPosWithOffsets();
+        const bool paused=beatmap_->isPaused() || beatmap_->isContinueScheduled();
+        if(time>=sample.start && time<=sample.end && sample.paused!=paused) {
+            sample.time=time;sample.paused=paused;sample.physical=beatmap_->getPhysicalButtonState();sample.relax=beatmap_->getInternalButtonState();sample.merged=sample.physical|sample.relax;spinnerTrace.observe(sample);
+        }
+    }
+    // The application selected the initial skin before construction. A later
+    // request waits for preparation; identical paths do not reload the skin.
