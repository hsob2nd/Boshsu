+    check15(distance2(l.shape(Point(400,100)),Point(400,100))<1e-20,"Learned route changed the endpoint");
+    check15(distance2(l.shape(Point(100,100)),Point(100,100))<1e-20,"Learned route changed its start");
+    check15(l.shape(Point(250,100)).y>100,"Raw curvature did not affect the experimental route");
+    l.discard();check15(distance2(l.shape(Point(250,100)),Point(250,100))==0,"Pause retained a partial learned route");
+    l.begin(true);l.observe(f15(0,Point(100,100)),0,o);l.observe(f15(100,Point(170,100)),0,o);l.observe(f15(110,Point(170,100)),0,o);l.observe(f15(105,Point(170,100)),0,o);l.finish();unsigned rewound=0;for(auto n:l.counts())rewound+=n;check15(!rewound,"A backward clock retained partial learning");
