+// This adapter borrows native objects only for this transaction. There are no
+// per-frame vectors, retained object pointers, native score writes or OS events.
+class NativeObjects final : public Objects {
+public:
+    explicit NativeObjects(OsuBeatmapStandard* map,const std::vector<std::int64_t>& prefix):map_(map),objects_(map->getHitObjectsPointer()),now_(map->getCurMusicPosWithOffsets()),
+        window_(OsuGameRules::getHitWindow50(map)),preempt_(OsuGameRules::getApproachTime(map)),radius_(map->getRawHitcircleDiameter()/2.0) {
+        // Prefix maximum ends retain arbitrarily long overlapping sliders.
+        begin_=std::lower_bound(prefix.begin(),prefix.end(),double(now_)-window_)-prefix.begin();
+        end_=std::upper_bound(objects_.begin(),objects_.end(),double(now_)+preempt_,[](double t,OsuHitObject* o){return t<o->getTime();})-objects_.begin();
+    }
+    std::size_t size() const override {return objects_.size();}
+    std::size_t begin() const override {return begin_;}
+    std::size_t end() const override {return end_;}
+    Object at(std::size_t i) const override {return atTime(i,now_);}
+    Object atTime(std::size_t i,std::int64_t time) const override {
+        OsuHitObject* native=objects_[i];Object o;
+        o.kind=native->isSlider()?Kind::Slider:native->isSpinner()?Kind::Spinner:Kind::Circle;
+        o.start=native->getTime();o.end=o.start+native->getDuration();
+        o.head=point(native->getRawPosAt(native->getTime()));
+        // Maple integrates on map time. Read its requested path once, rather
+        // than reading the current path and immediately overwriting it.
+        o.path=point(native->getRawPosAt(long(std::max(o.start,std::min(time,o.end)))));
+        o.handled=native->isFinished();
+        o.visible=stable_remastered::personalObjectVisible(o.kind!=Kind::Circle,o.start,o.end,now_,preempt_,window_);
+        if(auto slider=dynamic_cast<OsuSlider*>(native)) {o.headHandled=slider->isStartCircleFinished();o.sliding=slider->isTrackingNative();}
+        return o;
+    }
+    std::size_t pick(Point p) const override {
+        // Source FindCircleAt's start-object test, including the strict early
+        // notelock-disabled boundary. Scoring still applies native blocking.
+        for(std::size_t i=begin_;i<end_;i++) {
+            const Object o=at(i);
+            if(o.kind==Kind::Spinner || o.handled || !o.visible || o.headHandled) continue;
+            if(gameplay::disableNotelock.getBool() && !(double(now_)>double(o.start)-window_)) continue;
+            if(double(now_)>double(o.start)+window_) continue;
+            if(distance2(p,o.head)<=radius_*radius_) return i;
+        }
+        return NoObject;
+    }
+private:
+    OsuBeatmapStandard* map_;
+    const std::vector<OsuHitObject*>& objects_;
+    long now_;
+    double window_,preempt_,radius_;
+    std::size_t begin_=0,end_=0;
+};
+}
