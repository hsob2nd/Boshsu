+    internal sealed class AssistLearningStore
+    {
+        sealed class Saved {public AssistLearningData Data {get;set;}=new AssistLearningData();public List<Guid> Attempts {get;set;}=new List<Guid>();}
+        readonly string root;readonly object gate=new object();
+        internal string Warning {get;private set;}
+        internal AssistLearningStore(string accounts){root=Path.Combine(Path.GetFullPath(accounts),"assist-learning");}
+        string PathFor(Guid id){if(id==Guid.Empty)throw new ArgumentException("A local profile is required.");return Path.Combine(root,id.ToString("N")+".json");}
+        void Plain(string path){for(var d=new DirectoryInfo(root);d!=null;d=d.Parent)if(d.Exists&&(d.Attributes&FileAttributes.ReparsePoint)!=0)throw new IOException("Movement storage is redirected.");if(File.Exists(path)&&(File.GetAttributes(path)&FileAttributes.ReparsePoint)!=0)throw new IOException("Movement file is redirected.");}
+        Saved Read(Guid id){
+            string path=PathFor(id);Plain(path);foreach(var p in new[]{path,path+".bak"}){
+                try{Plain(p);if(!File.Exists(p))continue;if(new FileInfo(p).Length>16384)throw new InvalidDataException("Movement file exceeds its limit.");
+                    var value=JsonConvert.DeserializeObject<Saved>(File.ReadAllText(p));value.Data.Validate();if(value.Attempts==null||value.Attempts.Count>32)throw new InvalidDataException("Invalid movement attempt list.");return value;
+                }catch(Exception e)when(e is IOException||e is ArgumentException||e is JsonException||e is NullReferenceException){Warning="Local movement learning recovered safely: "+e.Message;}
+            }return new Saved();
+        }
+        internal AssistLearningData Load(Guid id){lock(gate){try{return LocalAccountStore.Clone(Read(id).Data);}catch(Exception e)when(e is IOException||e is UnauthorizedAccessException){Warning="Local movement learning unavailable: "+e.Message;return new AssistLearningData();}}}
+        internal AssistLearningData Merge(Guid id,Guid attempt,AssistLearningData delta){lock(gate){
+            if(attempt==Guid.Empty)throw new ArgumentException("Movement summary needs an attempt ID.");delta.Validate(256);var saved=Read(id);if(saved.Attempts.Contains(attempt)||delta.Segments==0)return LocalAccountStore.Clone(saved.Data);
+            for(int i=0;i<8;i++){int count=saved.Data.Counts[i]+delta.Counts[i];double sum=saved.Data.CurvatureSums[i]+delta.CurvatureSums[i];if(count>2048){sum*=2048.0/count;count=2048;}saved.Data.Counts[i]=count;saved.Data.CurvatureSums[i]=sum;}
+            saved.Attempts.Add(attempt);if(saved.Attempts.Count>32)saved.Attempts.RemoveAt(0);saved.Data.Validate();string text=JsonConvert.SerializeObject(saved);if(text.Length>16384)throw new InvalidDataException("Movement summary exceeds its limit.");
+            Directory.CreateDirectory(root);string path=PathFor(id),temporary=path+".tmp";Plain(path);Plain(temporary);Plain(path+".bak");File.WriteAllText(temporary,text);if(File.Exists(path))File.Replace(temporary,path,path+".bak");else File.Move(temporary,path);return LocalAccountStore.Clone(saved.Data);
+        }}
+        internal void Reset(Guid id){lock(gate){string path=PathFor(id);foreach(string p in new[]{path,path+".bak",path+".tmp"}){Plain(p);if(File.Exists(p))File.Delete(p);}}}
+    }
+}
