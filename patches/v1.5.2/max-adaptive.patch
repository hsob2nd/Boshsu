+// GPL-3.0-or-later. Maple V1's physical-movement budget around the Max model.
+#pragma once
+#include "InputCoordinator.h"
+namespace ultimate { namespace personal {
+class MaxMovementBudget {
+public:
+    // V2 resumes a real device packet after its idle offset has faded. Seed
+    // that already-published offset, then spend only the new physical delta.
+    void resume(const Frame& anchor,Point offset,double intensity){owner_=anchor.owner;lastMap_=anchor.map;lastRaw_=anchor.input;offset_=offset;intensity_=intensity;}
+    void reset(){owner_=0;lastMap_=std::numeric_limits<std::int64_t>::min();lastRaw_=offset_=Point();intensity_=-1;}
+    Point process(const Frame& f,Point proposed,double intensity) {
+        if(!f.active||!f.assistAllowed||!f.owner||!finite(f.input)||!finite(proposed)||
+           !std::isfinite(intensity)||intensity<=0||intensity>.5){reset();return f.input;}
+        if(owner_!=f.owner||intensity_!=intensity||lastMap_==std::numeric_limits<std::int64_t>::min()||
+           f.map<lastMap_||double(f.map)-double(lastMap_)>512){
+            reset();owner_=f.owner;lastMap_=f.map;lastRaw_=f.input;intensity_=intensity;return f.input;
+        }
+        const auto elapsed=f.map-lastMap_;
+        // Repeated render polls must not buy more guidance. Preserve physical
+        // displacement until map time advances; raw input itself stays live.
+        if(elapsed==0)return Point(f.input.x+offset_.x,f.input.y+offset_.y);
+        const Point motion(f.input.x-lastRaw_.x,f.input.y-lastRaw_.y);
+        const double moving=std::sqrt(motion.x*motion.x+motion.y*motion.y);
+        // Max's existing .50 ceiling is its full-strength setting. Match V1's
+        // 0..1 physical budget without changing that model setting or output.
+        const double strength=intensity/.5;
+        if(moving/double(elapsed)<.001){
+            const double release=std::pow(1-.3*strength,double(elapsed));
+            offset_=Point(offset_.x*release,offset_.y*release);
+            if(distance2(offset_,Point())<1e-18)offset_=Point();
+        }else{
+            const Point desired(proposed.x-f.input.x,proposed.y-f.input.y);
+            const Point correction(desired.x-offset_.x,desired.y-offset_.y);
+            const double amount=std::sqrt(correction.x*correction.x+correction.y*correction.y);
+            const double budget=moving*strength;
+            // The same additional-offset cap used by Maple V1: tiny physical
+            // motion cannot turn into an arbitrary target-sized correction.
+            if(amount>1e-12){const double scale=std::min(1.,budget/amount);offset_=Point(offset_.x+correction.x*scale,offset_.y+correction.y*scale);}
+        }
+        lastMap_=f.map;lastRaw_=f.input;
+        const Point out(f.input.x+offset_.x,f.input.y+offset_.y);
+        if(!finite(out)){reset();return f.input;}return out;
+    }
+private:
+    std::uintptr_t owner_=0;
+    std::int64_t lastMap_=std::numeric_limits<std::int64_t>::min();
+    Point lastRaw_,offset_;double intensity_=-1;
+};
+}}
