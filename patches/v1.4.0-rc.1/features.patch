+using System;
+using System.Linq;
+using osu;
+using osu.Audio;
+using osu.GameModes.Play;
+using osu.GameplayElements.Scoring;
+using osu.Input;
+using StableRemastered.Accounts;
+using StableRemastered.Gameplay;
+namespace StableRemastered.Application
+{
+    // The supplied Bosh rulesets share the shell window, audio and input loop.
+    // Standard remains exclusively owned by McOsu. These scores have a separate
+    // archive and never enter Standard's PP, achievements or submission worker.
+    internal sealed class LegacyRulesetGameMode : Player
+    {
+        internal static double? ReplayRate=>InputManager.ReplayMode?(InputManager.ReplayScore?.ImportedReplayRate??InputManager.ReplayScore?.ClassicLocalResult?.Rate):null;
+        readonly Guid profile;
+        readonly OfflineEnvironment environment;
+        readonly string displayName;
+        bool saved,prepared;
+        internal static string LastLoadError {get;private set;}
+        osu.GameplayElements.Beatmaps.Beatmap selectedMap;
+        internal LegacyRulesetGameMode()
+        {
+            profile=ApplicationServices.Accounts.ProfileId;
+            environment=ApplicationServices.Accounts.Environment;
+            displayName=ApplicationServices.Accounts.Store.Profiles().First(p=>p.Id==profile).Username;
+        }
+        public override void Initialize()
+        {
+            ApplicationServices.ResetGameplayShortcuts();
+            LastLoadError=null;
+            selectedMap=osu.GameplayElements.Beatmaps.BeatmapManager.Current;
+            ApplicationServices.Gameplay.Stop();
+            (ApplicationServices.Gameplay as McOsuGameplayEngine)?.EndResultsAudio();
+            AudioEngine.Stop();AudioEngine.StopAllSampleEvents();
+            ModManager.RemoveTargetPractice();
+            base.Initialize();
+        }
+        protected override bool OnLoadComplete(bool success)
+        {
+            if(!success){osu.Graphics.Notifications.NotificationManager.ShowMessage("This mode could not load the map or replay. Your local records are unchanged.");GameBase.ChangeMode(OsuModes.SelectPlay);return true;}
+            prepared=true;
+            bool result=base.OnLoadComplete(success);
+            if(success && !InputManager.ReplayMode && currentScore!=null)currentScore.PlayerName=displayName;
+            return result;
+        }
+        protected override void OnLoadStart()
+        {
+            try{base.OnLoadStart();}
+            catch(Exception e){LastLoadError=e.ToString();osu_common.Helpers.Logger.Log("Supplied ruleset load failed: "+e,osu_common.Helpers.LoggingTarget.Runtime);throw;}
+        }
+        protected override void InitializeReplay()
+        {
+            // The supplied single-player base resets ReplayMode while preparing
+            // a new game. An explicitly selected local replay owns its frames.
+            if(InputManager.ReplayMode){osu.Online.StreamingManager.Reset();return;}
+            base.InitializeReplay();
+        }
+        internal void RetainLocalScore()
+        {
+            if(!prepared || saved || InputManager.ReplayMode || currentScore==null)return;
+            if(currentScore.TotalHits==0)return;
+            currentScore.Date=DateTime.UtcNow;currentScore.Seed=Seed;
+            try{
+                currentScore.ClassicLocalResult=ApplicationServices.ClassicScores.Capture(currentScore,profile,environment,
+                    selectedMap.DisplayTitleFull??selectedMap.DisplayTitle,selectedMap.Version,AudioEngine.CurrentPlaybackRate/100.0);
+                saved=true;
+            }catch(Exception e){osu.Graphics.Notifications.NotificationManager.ShowMessage("Mode score could not be saved: "+e.Message);}
+        }
+    }
+}
