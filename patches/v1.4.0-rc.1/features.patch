+namespace StableRemastered.Application
+{
+    // Filesystem work is invoked on ShellWork, never on the render thread.
+    internal static class LibraryImport
+    {
+        internal sealed class Source
+        {
+            internal string Songs;
+            internal readonly List<string> Skins=new List<string>();
+        }
+        internal sealed class Result
+        {
+            internal readonly List<string> Names=new List<string>();
+            internal int Files;
+            internal long Bytes;
+        }
+        static readonly HashSet<string> Extensions=new HashSet<string>(new[]{".ini",".png",".jpg",".jpeg",".bmp",".gif",".wav",".ogg",".mp3",".ttf",".otf",".txt"},StringComparer.OrdinalIgnoreCase);
+        static string Full(string path){string full=Path.GetFullPath(path);return full.Length==Path.GetPathRoot(full).Length?full:full.TrimEnd(Path.DirectorySeparatorChar,Path.AltDirectorySeparatorChar);}
+        static bool Reparse(string path)=>(File.GetAttributes(path)&FileAttributes.ReparsePoint)!=0;
+        static bool Skin(string path)=>Directory.Exists(path) && !Reparse(path) && Directory.EnumerateFiles(path).Any(f=>new[]{"skin.ini","hitcircle.png","hitcircle@2x.png","cursor.png","cursor@2x.png","mania-note1.png"}.Contains(Path.GetFileName(f),StringComparer.OrdinalIgnoreCase));
+        internal static Source Inspect(string selected,CancellationToken cancel)
+        {
+            cancel.ThrowIfCancellationRequested();string root=Full(selected);
+            if(!Directory.Exists(root)||Reparse(root))throw new IOException("Choose an ordinary local osu! installation, Songs/Skins folder, or skin folder.");
