+                }finally{
+                    // Only the exact random staging directory created above is disposable.
+                    if(Directory.Exists(stage)&&!Reparse(stage))Directory.Delete(stage,true);
+                }
+            }
+            return result;
+        }
+        static void Copy(string source,string destination,CancellationToken cancel,Result result,int depth)
+        {
+            cancel.ThrowIfCancellationRequested();if(depth>32)throw new IOException("The skin contains too many nested folders.");
+            if(Reparse(source))throw new IOException("Skin links/junctions are not imported. Copy an ordinary skin folder instead.");
+            foreach(string file in Directory.EnumerateFiles(source)){
+                cancel.ThrowIfCancellationRequested();if(!Extensions.Contains(Path.GetExtension(file)))continue;
