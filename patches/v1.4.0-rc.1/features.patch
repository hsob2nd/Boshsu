+#pragma once
+#include <algorithm>
+#include <cmath>
+namespace stable_remastered {
+// Presentation only: never changes input coordinates, judgments or map time.
+struct FlashlightPresentation {
+    double x=0,y=0,scale=3.2,last=0;bool initialized=false;
+    void reset(){initialized=false;}
+    static double target(int combo,bool inBreak){return inBreak?8.0:combo<100?3.2:combo<200?2.6:2.0;}
+    void update(double now,double px,double py,int combo,bool inBreak){
+        if(!std::isfinite(now)||!std::isfinite(px)||!std::isfinite(py)){reset();return;}
+        const double goal=target(combo,inBreak);
+        if(!initialized||now<last){x=px;y=py;scale=goal;last=now;initialized=true;return;}
+        const double dt=std::max(0.0,now-last);last=now;
+        const double blend=-std::expm1(-dt/.12);x+=(px-x)*blend;y+=(py-y)*blend;
+        // Supplied frontend's 3.2/2.6/2.0/8.0 scale states and 0.1 per
+        // 60-Hz-step rate, expressed in elapsed seconds.
+        const double move=6*dt;scale+=std::max(-move,std::min(move,goal-scale));
+    }
+    double radius(double viewportHeight)const{return 50*scale*viewportHeight/480;}
+};
+}
