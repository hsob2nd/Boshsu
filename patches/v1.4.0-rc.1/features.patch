+using System;
+using System.IO;
+using System.Linq;
+using System.Reflection;
+using System.Threading;
+using Newtonsoft.Json;
+using Newtonsoft.Json.Linq;
+using StableRemastered.Gameplay;
+class OsrActualRoundtrip
+{
+    const BindingFlags F=BindingFlags.Static|BindingFlags.Instance|BindingFlags.NonPublic|BindingFlags.Public;
+    static int Main(string[] args){try{
+        string fixture=Path.GetFullPath(args[0]),output=Path.GetFullPath(args[1]);if(Directory.Exists(output))throw new Exception("Use a fresh round-trip fixture.");Directory.CreateDirectory(output);
+        var summary=JObject.Parse(File.ReadAllText(Path.Combine(fixture,"qualification/summary.json")));var result=summary["Cycles"].Last["Original"].ToObject<StableResult>();
+        string native=Path.IsPathRooted(result.ReplayPath)?result.ReplayPath:Path.Combine(fixture,"replays",result.ReplayPath),osr=Path.Combine(output,"actual.osr");
+        var codec=typeof(StableResult).Assembly.GetType("StableRemastered.Online.OsrExchange",true);
+        codec.GetMethod("Export",F).Invoke(null,new object[]{osr,native,result,"Owned fixture",CancellationToken.None});
+        var imported=codec.GetMethod("Import",F).Invoke(null,new object[]{osr,Path.Combine(output,"cache"),new GameplaySettings(),CancellationToken.None});var t=imported.GetType();string importedPath=(string)t.GetField("NativePath",F).GetValue(imported);var settings=(GameplaySettings)t.GetField("Settings",F).GetValue(imported);
+        if(!File.ReadAllBytes(native).SequenceEqual(File.ReadAllBytes(importedPath)))throw new Exception("Canonical input changed through OSR round trip.");
+        string metadata=File.ReadAllText(osr+".boshsu.json");if(metadata.Contains("LocalProfileId")||metadata.Contains(fixture)||metadata.Contains("PPProvider"))throw new Exception("Personal identity/path/provider leaked into export metadata.");
+        result.Context.Settings=settings;result.ReplayPath=importedPath;
+        File.WriteAllText(Path.Combine(output,"regression.json"),JsonConvert.SerializeObject(result));
+        File.WriteAllText(Path.Combine(output,"summary.json"),JsonConvert.SerializeObject(new{Passed=true,CanonicalByteExact=true,HasCustomSettings=(bool)t.GetField("CustomSettings",F).GetValue(imported),Score=result.Score,Hits=result.TotalHits,MapHash=result.BeatmapMD5,MetadataExcludesProfilePathAndPPProvider=true},Formatting.Indented));Console.WriteLine("Actual native score OSR export/import: canonical input exact; privacy checks passed.");return 0;
+    }catch(Exception e){Console.Error.WriteLine(e);return 1;}}
+}
