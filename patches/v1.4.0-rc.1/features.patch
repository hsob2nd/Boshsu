+using System;
+namespace StableRemastered.Gameplay
+{
+    public static class GameplayRouting
+    {
+        // A native ruleset map wins over the conversion selected in Song Select.
+        public static GameplayMode Resolve(GameplayMode map,GameplayMode selected,GameplayMode? replay=null)
+        {
+            if(!Enum.IsDefined(typeof(GameplayMode),map))throw new ArgumentOutOfRangeException(nameof(map));
+            if(replay.HasValue && map!=GameplayMode.Standard && replay.Value!=map)throw new ArgumentException("Replay ruleset does not match this native-mode beatmap.",nameof(replay));
+            var mode=replay??(map==GameplayMode.Standard?selected:map);
+            if(!Enum.IsDefined(typeof(GameplayMode),mode))throw new ArgumentOutOfRangeException(nameof(mode));
+            return mode;
+        }
+    }
+}
