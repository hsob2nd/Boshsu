+            string skins=name.Equals("Skins",StringComparison.OrdinalIgnoreCase)?root:Path.Combine(root,"Skins");
+            if(Directory.Exists(skins)&&!Reparse(skins)){
+                foreach(string child in Directory.EnumerateDirectories(skins)){cancel.ThrowIfCancellationRequested();if(Skin(child))result.Skins.Add(child);}
+            }else if(Skin(root))result.Skins.Add(root);
+            result.Skins.Sort(StringComparer.OrdinalIgnoreCase);
+            if(result.Songs==null&&result.Skins.Count==0)throw new IOException("No Songs folder or skin assets were found. Choose the osu! installation, its Songs/Skins folder, or a skin containing skin.ini or gameplay images.");
