+                if(string.Equals(Path.GetDirectoryName(original),target,StringComparison.OrdinalIgnoreCase))throw new IOException("These skins are already in this client's Skins folder.");
+            }
+            Directory.CreateDirectory(target);
+            if(Reparse(target))throw new IOException("The destination Skins folder must not be a junction or symbolic link.");
+            var result=new Result();
+            foreach(string skin in source.Skins){
+                cancel.ThrowIfCancellationRequested();string original=Full(skin);
+                if(!Skin(original))throw new IOException("The selected skin is no longer available: "+Path.GetFileName(original));
+                string prefix=original+Path.DirectorySeparatorChar;
+                if(target.Equals(original,StringComparison.OrdinalIgnoreCase)||target.StartsWith(prefix,StringComparison.OrdinalIgnoreCase))throw new IOException("Choose skins outside this client's Skins folder.");
+                string label=Path.GetFileName(original),final=Path.Combine(target,label);int number=1;
+                while(Directory.Exists(final)||File.Exists(final))final=Path.Combine(target,label+" (imported "+(number++)+")");
+                // Unpublished staging is a sibling of Skins, so it cannot become selectable.
+                string stage=Path.Combine(Path.GetDirectoryName(target),".boshsu-skin-import-"+Guid.NewGuid().ToString("N"));
