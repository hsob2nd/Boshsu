+using System;
+using StableRemastered.Shell;
+namespace StableRemastered.Application.Shell
+{
+    internal static partial class ShellPresentation
+    {
+        internal static void ShowWindowsIntegration()
+        {
+            Page("Windows integration","Application identity and discovery",d=>{
+                var c=d.Canvas;var r=d.Content;
+                c.Text("Boshsu · Windows registration",22,r.X,r.Y,r.Width,BoshTheme.Text,true);
+                c.Text("Adds this copy to Windows application records and the Start menu. Software that reads those records can find its name, icon and executable.",13,r.X,r.Y+44,r.Width,BoshTheme.Muted,false,.95f,64);
+                bool enabled=ShellPreferences.Current.RegisterWithWindows;
+                c.Button("Register with Windows  ·  "+(enabled?"On":"Off"),new ShellRect(r.X,r.Y+120,r.Width,38),()=>Safe(()=>{
+                    var next=ShellPreferences.Copy();next.RegisterWithWindows=!enabled;ShellPreferences.Save(next);
+                    WindowsApplicationIdentity.ApplyPreference(next.RegisterWithWindows);d.Reflow=true;
+                }));
+                c.Button("Repair registration for this copy",new ShellRect(r.X,r.Y+172,r.Width,38),()=>{WindowsApplicationIdentity.ApplyPreference(true);d.Reflow=true;},false,enabled);
+                c.Text(WindowsApplicationIdentity.Status,13,r.X,r.Y+228,r.Width,BoshTheme.Accent,false,.95f,64);
+                c.Text("Game recognition is controlled by each recording app. Windows registration does not add Boshsu to AMD or Insights' supported-game catalogue, or enable their automatic highlights.",13,r.X,r.Y+310,r.Width,BoshTheme.Muted,false,.95f,84);
+            });
+        }
+    }
+}
