+param([Parameter(Mandatory=$true)][string]$Runtime,[string]$Evidence,[string]$CSharpCompilerPath)
+$ErrorActionPreference = 'Stop'
+. (Join-Path $PSScriptRoot 'Toolchain.ps1')
+$compiler = Find-BoshCSharp $CSharpCompilerPath
+$projectRoot = Split-Path -Parent $PSScriptRoot
+$runtimeRoot = (Resolve-Path -LiteralPath $Runtime).Path
+if (!$Evidence) { $Evidence = Join-Path $projectRoot ('_build/tests/release-' + [Guid]::NewGuid().ToString('N')) }
+if (Test-Path -LiteralPath $Evidence) { throw 'Use a new evidence folder; test state must not overwrite existing files.' }
+New-Item -ItemType Directory -Path $Evidence | Out-Null
+$testRoot = (Resolve-Path -LiteralPath $Evidence).Path
+# A disposable copy prevents reflection-based fixtures from touching player data.
+Get-ChildItem -LiteralPath $runtimeRoot -File | Where-Object Extension -in '.dll','.exe' | Copy-Item -Destination $testRoot
+$hostFile = Join-Path $testRoot 'StableRemastered.exe'
+if (!(Test-Path -LiteralPath $hostFile)) { Copy-Item -LiteralPath (Join-Path $testRoot 'Boshsu.exe') -Destination $hostFile }
+$json = Join-Path $testRoot 'Newtonsoft.Json.dll'
+$common = Join-Path $testRoot 'osu!common.dll'
+$summary = @()
+Push-Location $testRoot
+try {
+    foreach ($name in 'ContractTests','V101BridgeTests','ShellContractTests','OfflineShellTests','ClientUpdateTests','V13OverheadTests') {
+        $target = Join-Path $testRoot ($name+'.exe')
+        & $compiler /nologo /target:exe /platform:x64 /langversion:7.3 /r:System.Numerics.dll /r:System.Drawing.dll /r:System.Windows.Forms.dll /r:System.IO.Compression.dll /r:System.IO.Compression.FileSystem.dll "/r:$hostFile" "/r:$json" "/r:$common" "/out:$target" (Join-Path $projectRoot ('tests/'+$name+'.cs'))
+        if ($LASTEXITCODE -ne 0) { throw "$name compilation failed." }
+        $arguments = @()
+        switch ($name) {
+            'V101BridgeTests' { $arguments = @(Join-Path $testRoot 'bridge.json') }
+            'OfflineShellTests' { $arguments = @($hostFile) }
+            'ClientUpdateTests' { $arguments = @(Join-Path $testRoot 'updates-fixture') }
+            'V13OverheadTests' { $arguments = @(Join-Path $testRoot 'overhead.json') }
+        }
+        $output = @(& $target @arguments 2>&1)
+        $code = $LASTEXITCODE
+        $output | Set-Content -LiteralPath (Join-Path $testRoot ($name+'.log'))
+        $summary += [PSCustomObject]@{Name=$name;Passed=($code -eq 0);ExitCode=$code;Output=($output -join "`n")}
+        if ($code -ne 0) { throw "$name failed. See $testRoot" }
+        Write-Output "$name passed"
+    }
+} finally {
+    Pop-Location
+    $summary | ConvertTo-Json -Depth 5 | Set-Content -LiteralPath (Join-Path $testRoot 'summary.json')
+}
