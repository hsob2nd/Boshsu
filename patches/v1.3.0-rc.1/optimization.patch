+R=Path(__file__).resolve().parents[1]
+def sha(p):
+ h=hashlib.sha256()
+ with p.open('rb') as f:
+  for chunk in iter(lambda:f.read(1024*1024),b''):h.update(chunk)
+ return h.hexdigest()
+def main():
+ p=argparse.ArgumentParser();p.add_argument('--runtime',type=Path,required=True);p.add_argument('--verify-only',action='store_true');a=p.parse_args();runtime=a.runtime.resolve();pins=json.loads((R/'engine/pins/runtime-dependencies.json').read_text());copies=[]
+ for name,expected in pins.items():
+  if sha(runtime/name)!=expected:raise ValueError('Pinned runtime dependency differs: '+name)
+ ns={'m':'http://schemas.microsoft.com/developer/msbuild/2003'}
+ for project in (R/'frontend/Bosh').glob('*/*.csproj'):
+  for hint in ET.parse(project).findall('.//m:HintPath',ns):
+   target=(project.parent/hint.text.replace('\\','/')).resolve();name=target.name
+   if name not in pins:raise ValueError('Uninventoried binary reference: '+name)
+   if not target.is_relative_to(R.resolve()):raise ValueError('Reference escapes source root: '+name)
+   copies.append((runtime/name,target))
+  for content in ET.parse(project).findall('.//m:Content',ns):
+   relative=content.attrib.get('Include','')
+   if not relative.lower().endswith('.dll'):continue
+   target=(project.parent/relative.replace('\\','/')).resolve();name=target.name
+   if name not in pins or not target.is_relative_to(R.resolve()):raise ValueError('Uninventoried/unsafe runtime content: '+relative)
+   copies.append((runtime/name,target))
+ for name in ('bass.dll','bass_fx.dll','bosh_pp.dll','stable_transformed_pp.dll','bosh_akatsuki_pp.dll','bosh_ccv3_pp.dll'):copies.append((runtime/name,R/'frontend/Bosh/osu!win'/name))
+ for source,target in copies:
+  if a.verify_only:continue
