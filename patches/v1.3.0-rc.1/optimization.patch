+        const auto target=std::uint64_t(std::ceil(count*fraction));std::uint64_t seen=0;
+        for(unsigned i=0;i<BucketCount;i++)if((seen+=bins[i])>=target)return i==BucketCount-1?maximum:(i+1)*BucketMs;
+        return 0;
+    }
+    nlohmann::json json() const {return {{"Samples",count},{"MedianMsUpperBound",count?percentile(.5):0},{"MeanMs",count?sum/count:0},{"P95MsUpperBound",count?percentile(.95):0},{"P99MsUpperBound",count?percentile(.99):0},{"P999MsUpperBound",count?percentile(.999):0},{"MaxMs",maximum}};}
+    nlohmann::json histogram() const {
+        const unsigned bounds[]={100,200,400,800,1600,3200,BucketCount};
+        const char* names[]={"LessThan0.5Ms","0.5To1Ms","1To2Ms","2To4Ms","4To8Ms","8To16Ms","AtLeast16Ms"};
+        nlohmann::json result=nlohmann::json::object();unsigned begin=0;for(unsigned j=0;j<7;j++){std::uint64_t total=0;for(unsigned i=begin;i<bounds[j];i++)total+=bins[i];result[names[j]]=total;begin=bounds[j];}return result;
+    }
+};
+}}
