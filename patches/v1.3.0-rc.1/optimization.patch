+using System;
+using System.Globalization;
+
+namespace StableRemastered.Performance
+{
+    // One menu owner's last selection. Preserve the existing textual cache key,
+    // including runtime CS fields, but only format it when an input changes.
+    public sealed class PPSelectionIdentity
+    {
+        string path,hash,calculator,provider,text;
+        uint mods;double rate,cs;bool changer;long revision;
+        public string Resolve(string file,string md5,uint modBits,double playbackRate,bool csChanger,double csValue,string calculationVersion,string providerKey,long providerRevision)
+        {
+            if(text!=null && string.Equals(path,file,StringComparison.Ordinal) && string.Equals(hash,md5,StringComparison.Ordinal) &&
+                mods==modBits && rate.Equals(playbackRate) && changer==csChanger && cs.Equals(csValue) &&
+                string.Equals(calculator,calculationVersion,StringComparison.Ordinal) && string.Equals(provider,providerKey,StringComparison.Ordinal) && revision==providerRevision)
+                return text;
+            path=file;hash=md5;mods=modBits;rate=playbackRate;changer=csChanger;cs=csValue;calculator=calculationVersion;provider=providerKey;revision=providerRevision;
+            // BindableBool's historical text form is 1/0, not True/False.
+            text=file+":"+md5+":"+modBits+":"+playbackRate.ToString("R",CultureInfo.InvariantCulture)+":"+(csChanger?"1":"0")+":"+csValue.ToString("R",CultureInfo.InvariantCulture)+":"+calculationVersion+":"+providerKey+":"+providerRevision.ToString(CultureInfo.InvariantCulture);
+            return text;
+        }
+    }
+}
