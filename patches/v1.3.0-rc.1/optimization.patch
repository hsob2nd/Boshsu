+    std::array<std::uint64_t,BucketCount> bins{};
+    std::uint64_t count=0;
+    double sum=0,maximum=0;
+    void add(double ms) {++count;sum+=ms;maximum=std::max(maximum,ms);++bins[std::min<unsigned>(BucketCount-1,unsigned(std::max(0.0,ms)/BucketMs))];}
