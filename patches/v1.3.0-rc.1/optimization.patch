+namespace stable_remastered {
+// Explicit diagnostic mode only. One worker, bounded records/bytes, FIFO order.
+// The worker owns directory scans and file writes; it never touches game/GL state.
+class DiagnosticWriter {
+public:
+    struct Job {std::string name,text;bool append;};
