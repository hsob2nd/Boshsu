@@ -0,0 +1,51 @@
+"""Summarize recorded foreground frames without averaging percentiles or duplicating shutdown snapshots."""
+import argparse,json,statistics
+from pathlib import Path
+
+def summarize(root):
+    reports=[]
+    for path in (root/'performance').glob('native-*.json'):
+        row=json.loads(path.read_text())
+        # Shutdown can repeat the same final attempt. Keep the last cumulative report.
+        row['_file']=path.name
+        reports.append(row)
+    rows=[]
+    for row in sorted(reports,key=lambda r:int(r['_file'].rsplit('-',1)[1].split('.')[0])):
+        # Retry resets metrics without changing the session number. Its partial
+        # AttemptSaved report is a distinct attempt and must remain included.
+        if row['Reason']=='Shutdown' and any(r['_file'].rsplit('-',2)[1]==row['_file'].rsplit('-',2)[1] and r['Frame']==row['Frame'] for r in rows):continue
+        rows.append(row)
+    frames=sum(r['Frame']['Samples'] for r in rows)
+    def distribution(name):
+        valid=[r[name] for r in rows if r[name]['Samples']]
+        samples=sum(v['Samples'] for v in valid)
+        return dict(Samples=samples,WeightedMeanMs=sum(v['Samples']*v['MeanMs'] for v in valid)/max(1,samples),
