+ for source,target in copies:
+  if a.verify_only:continue
+  target.parent.mkdir(parents=True,exist_ok=True)
+  if not target.exists():shutil.copy2(source,target)
+ print(json.dumps(dict(Passed=True,PinnedDependencies=len(pins),References=len(copies),VerifyOnly=a.verify_only,NetworkUsed=False,PlayerDataUsed=False)))
