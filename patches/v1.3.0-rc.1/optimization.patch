+$ErrorActionPreference = 'Stop'
+function Find-BoshMSBuild([string]$Explicit) {
+    if ($Explicit) { return (Resolve-Path -LiteralPath $Explicit -ErrorAction Stop).Path }
+    if ($env:BOSHSU_MSBUILD) { return (Resolve-Path -LiteralPath $env:BOSHSU_MSBUILD -ErrorAction Stop).Path }
+    $command = Get-Command msbuild.exe -ErrorAction SilentlyContinue
+    if ($command) { return $command.Source }
+    $installer = Join-Path ${env:ProgramFiles(x86)} 'Microsoft Visual Studio/Installer/vswhere.exe'
+    if (Test-Path -LiteralPath $installer) {
+        $found = @(& $installer -latest -products '*' -requires Microsoft.Component.MSBuild -find 'MSBuild/**/Bin/MSBuild.exe')
+        if ($found.Count) { return $found[0] }
+    }
+    throw 'MSBuild was not found. Install Visual Studio Build Tools with .NET Framework 4.8 targeting support, or pass -MSBuildPath.'
+}
+function Find-BoshCSharp([string]$Explicit) {
+    if ($Explicit) { return (Resolve-Path -LiteralPath $Explicit -ErrorAction Stop).Path }
+    $compiler = Join-Path (Split-Path -Parent (Find-BoshMSBuild)) 'Roslyn/csc.exe'
+    return (Resolve-Path -LiteralPath $compiler -ErrorAction Stop).Path
+}
+function Find-BoshCMake([string]$Explicit) {
+    if ($Explicit) { return (Resolve-Path -LiteralPath $Explicit -ErrorAction Stop).Path }
+    $command = Get-Command cmake.exe -ErrorAction SilentlyContinue
+    if ($command) { return $command.Source }
+    $msbuild = Find-BoshMSBuild
+    $installation = Split-Path -Parent (Split-Path -Parent (Split-Path -Parent (Split-Path -Parent $msbuild)))
+    return (Resolve-Path -LiteralPath (Join-Path $installation 'Common7/IDE/CommonExtensions/Microsoft/CMake/CMake/bin/cmake.exe') -ErrorAction Stop).Path
+}
