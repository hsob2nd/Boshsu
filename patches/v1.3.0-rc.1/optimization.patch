+// Full-package updater exercise. Requires an explicitly marked disposable copy.
+using System;using System.IO;using System.Linq;using System.Collections.Generic;using System.IO.Compression;using Newtonsoft.Json;using StableRemastered.Updates;
+class PackagePreservationTests
+{
+    static int checks;static void Check(bool value,string label){checks++;if(!value)throw new Exception(label);}
+    static Dictionary<string,string> Snapshot(string root,HashSet<string> application)
+    {
+        return Directory.GetFiles(root,"*",SearchOption.AllDirectories).Select(p=>new{File=p,Name=p.Substring(root.Length+1).Replace('\\','/')}).Where(p=>!application.Contains(p.Name)&&!p.Name.StartsWith("Updates/",StringComparison.OrdinalIgnoreCase)).ToDictionary(p=>p.Name,p=>ClientUpdatePackage.Hash(p.File),StringComparer.OrdinalIgnoreCase);
+    }
+    static int Main(string[] args)
+    {
+        try{
+            string root=Path.GetFullPath(args[0]);Check(new DirectoryInfo(root).Name=="installation-copy"&&File.Exists(Path.Combine(root,"CLIENT_COPY_ONLY.txt")),"Only a marked disposable installation copy is permitted");
+            var old=JsonConvert.DeserializeObject<Dictionary<string,string>>(File.ReadAllText(Path.Combine(root,"BOSHSU_FILES.json")));var application=new HashSet<string>(old.Keys,StringComparer.OrdinalIgnoreCase);application.Add("BOSHSU_FILES.json");
+            string archive=Path.GetFullPath(args[1]),hash=ClientUpdatePackage.Hash(archive);var files=ClientUpdatePackage.Verify(archive,hash,args[2]);application.UnionWith(files.Keys);
+            var protectedBefore=Snapshot(root,application);var binaryBefore=ClientUpdatePackage.Hash(Path.Combine(root,"Boshsu.exe"));var metadataBefore=ClientUpdatePackage.Hash(Path.Combine(root,"BOSHSU_BUILD.json"));
+            var job=new UpdateJob{Root=root,Archive=archive,SHA256=hash,Tag=args[2]};bool rejected=false;
+            try{ClientUpdatePackage.Install(job,n=>{if(n==2)throw new IOException("Deliberate copied-installation failure");});}catch(IOException){rejected=true;}
+            Check(rejected,"Injected partial installation fails");Check(ClientUpdatePackage.Hash(Path.Combine(root,"Boshsu.exe"))==binaryBefore&&ClientUpdatePackage.Hash(Path.Combine(root,"BOSHSU_BUILD.json"))==metadataBefore,"Application and metadata restored after failed installation");
+            foreach(var file in protectedBefore)Check(File.Exists(Path.Combine(root,file.Key))&&ClientUpdatePackage.Hash(Path.Combine(root,file.Key))==file.Value,"Protected copy preserved through rollback");
+            ClientUpdatePackage.Install(job);
+            foreach(var file in protectedBefore)Check(File.Exists(Path.Combine(root,file.Key))&&ClientUpdatePackage.Hash(Path.Combine(root,file.Key))==file.Value,"Protected copy preserved through update");
+            foreach(var file in files)Check(ClientUpdatePackage.Hash(Path.Combine(root,file.Key))==file.Value,"Every installed application file matches the package");
+            Check(Directory.GetDirectories(Path.Combine(root,"Updates"),"rollback-*").Length==1,"One managed recovery version retained");Check(Directory.GetDirectories(Path.Combine(root,"Updates"),"stage-*").Length==0,"Staging folders released");
