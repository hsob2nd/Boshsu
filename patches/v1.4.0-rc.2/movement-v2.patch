+"""Compare actual queued-artwork implementations in isolated CPU processes."""
+from pathlib import Path
+import argparse,json,re,statistics,subprocess,zipfile
+R=Path(__file__).resolve().parents[1]
+def main():
+    p=argparse.ArgumentParser();p.add_argument('--compiler',type=Path,required=True);p.add_argument('--baseline-source',type=Path,required=True);p.add_argument('--output',type=Path,required=True);a=p.parse_args();a.output=a.output.resolve()
+    if a.output.exists():raise ValueError('Use a fresh comparison folder.')
+    a.output.mkdir(parents=True)
+    with zipfile.ZipFile(a.baseline_source) as z:(a.output/'ShellWork-baseline.cs').write_bytes(z.read('stable-remastered/application/Shell/ShellWork.cs'))
+    rows=[]
+    for name,source in [('baseline',a.output/'ShellWork-baseline.cs'),('candidate',R/'application/Shell/ShellWork.cs')]:
+        exe=a.output/(name+'.exe');build=subprocess.run([str(a.compiler),'/nologo','/target:exe','/platform:x64','/langversion:7.3','/out:'+str(exe),str(R/'tests/ShellWorkTests.cs'),str(source)],capture_output=True,text=True)
+        (a.output/(name+'-build.log')).write_text(build.stdout+build.stderr)
+        if build.returncode:raise ValueError('Worker fixture did not compile: '+name)
+        samples=[]
+        for n in range(3):
+            result=subprocess.run([str(exe)],capture_output=True,text=True,timeout=30);(a.output/(name+'-'+str(n)+'.log')).write_text(result.stdout+result.stderr)
+            if result.returncode:raise ValueError('Worker fixture failed: '+name)
+            match=re.search(r'(\d+) shell worker checks passed; blocked-queue 300ms allocated bytes=(\d+); shutdownMs=([\d.]+)',result.stdout)
+            if not match:raise ValueError('Missing worker comparison result.')
+            samples.append(dict(Checks=int(match[1]),IdleAllocatedBytes=int(match[2]),ShutdownMs=float(match[3])))
+        rows.append(dict(Name=name,Samples=samples,MedianIdleAllocatedBytes=statistics.median(x['IdleAllocatedBytes'] for x in samples)))
+    report=dict(Passed=True,Rows=rows,Scope='48 queued artwork jobs during simulated gameplay; 300ms idle allocation samples, admission/cancellation/shutdown tests using actual old/new worker source. Not whole-client FPS or GPU latency qualification.')
+    (a.output/'summary.json').write_text(json.dumps(report,indent=2)+'\n');print(json.dumps(report,indent=2))
+if __name__=='__main__':main()
