+    static void Until(Func<bool> test,string label){var clock=Stopwatch.StartNew();while(!test()){if(clock.ElapsedMilliseconds>5000)throw new Exception(label);Thread.Sleep(5);}checks++;}
+    static int Main(string[] args){try{
+        AppDomain.MonitoringIsEnabled=true;var cancel=new CancellationTokenSource();
+        var held=Enumerable.Range(0,48).Select(n=>ShellWork.Run(token=>{Interlocked.Increment(ref calls);return n;},cancel.Token)).ToArray();
+        Thread.Sleep(200);Check(calls==0&&ShellWork.Active==0&&ShellWork.Queued==48,"Gameplay started artwork instead of deferring it");
+        long before=AppDomain.CurrentDomain.MonitoringTotalAllocatedMemorySize;Thread.Sleep(300);long idle=AppDomain.CurrentDomain.MonitoringTotalAllocatedMemorySize-before;
+        Check(calls==0&&held.All(t=>!t.IsCompleted),"Blocked artwork unexpectedly completed");
+        cancel.Cancel();Until(()=>held.All(t=>t.IsCompleted),"Cancelled blocked jobs did not finish");Check(held.All(t=>t.IsCanceled),"Blocked cancellations faulted or ran work");Until(()=>ShellWork.Queued==0,"Cancelled queue leaked counters");
+        using(var release=new ManualResetEventSlim(false)){
+            var jobs=Enumerable.Range(0,12).Select(n=>ShellWork.Run(token=>{int a=Interlocked.Increment(ref active);int old;do{old=peak;if(a<=old)break;}while(Interlocked.CompareExchange(ref peak,a,old)!=old);Interlocked.Increment(ref calls);release.Wait(token);Interlocked.Decrement(ref active);return n;},CancellationToken.None)).ToArray();
+            osu.GameBase.Change(osu.OsuModes.Menu);Until(()=>ShellWork.Active==2,"Returning to menus did not wake queued artwork");Thread.Sleep(30);Check(peak==2&&ShellWork.Active==2&&ShellWork.Queued==10,"Worker bound was not respected");
+            ShellPreferences.SetLimit(3);Until(()=>ShellWork.Active==3,"Performance-profile change did not wake the additional slot");Check(peak==3,"Worker profile exceeded its bound");release.Set();Check(Task.WaitAll(jobs,5000),"Queued jobs did not drain");Check(jobs.Select(t=>t.Result).OrderBy(n=>n).SequenceEqual(Enumerable.Range(0,12)),"Queue lost or duplicated jobs");
+        }
+        Until(()=>ShellWork.Active==0&&ShellWork.Queued==0,"Completed jobs leaked counters");
+        var fault=ShellWork.Run<int>(token=>{throw new InvalidOperationException("Expected fixture failure");},CancellationToken.None);Until(()=>fault.IsCompleted,"Worker exception did not complete");Check(fault.IsFaulted&&fault.Exception.GetBaseException().Message=="Expected fixture failure","Worker failure was hidden");
+        var next=ShellWork.Run(token=>42,CancellationToken.None);Check(next.Wait(5000)&&next.Result==42,"Failed job stranded queue capacity");
+        osu.GameBase.Change(osu.OsuModes.Play);var pending=Enumerable.Range(0,16).Select(n=>ShellWork.Run(token=>n,CancellationToken.None)).ToArray();var clock2=Stopwatch.StartNew();ShellWork.Shutdown();Check(pending.All(t=>t.IsCompleted&&t.IsCanceled),"Shutdown did not cancel blocked artwork");Check(ShellWork.Active==0&&ShellWork.Queued==0,"Shutdown retained queue slots");Check(ShellWork.Run(token=>0,CancellationToken.None).IsCanceled,"Shutdown accepted new artwork");
+        Console.WriteLine(checks+" shell worker checks passed; blocked-queue 300ms allocated bytes="+idle+"; shutdownMs="+clock2.Elapsed.TotalMilliseconds.ToString("F2"));return 0;
+    }catch(Exception e){Console.Error.WriteLine(e);return 1;}}
