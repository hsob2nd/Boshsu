+// Boshsu Max V2 refinement around the unchanged qualified planner. GPL-3.0-or-later.
+#pragma once
+#include "MaxMovementBudget.h"
+#include "MaxCursorAuthority.h"
+namespace ultimate { namespace personal {
+class MaxAssistV2 {
+public:
+    void reset(){budget_.reset();owner_=0;lastMap_=std::numeric_limits<std::int64_t>::min();target_=NoObject;body_=false;fine_=lastRaw_=lastPlanned_=Point();}
+    Point process(const Frame& f,Point planned,double intensity,const Settings& ac,
+                  const Objects& objects,std::size_t target,double approach,double power,double sliderPower) {
+        const auto geometry=AssistTargetGeometry::resolve(f,ac);
+        if(!f.active||!f.assistAllowed||!f.owner||!finite(f.input)||!finite(planned)||!geometry.valid||
+           !std::isfinite(intensity)||intensity<=0||intensity>.5||!validPower(power)||!validPower(sliderPower)||
+           !std::isfinite(approach)||approach<=0||target>=objects.size()||
+           !MaxCursorAuthority::relevant(objects.at(target),f,approach)){reset();return f.input;}
+        const Object current=objects.at(target);
+        const bool currentBody=current.kind==Kind::Slider&&current.headHandled&&f.map>=current.start&&f.map<=current.end;
+        if(owner_!=f.owner||lastMap_==std::numeric_limits<std::int64_t>::min()||f.map<lastMap_||
+           double(f.map)-double(lastMap_)>512||intensity_!=intensity||power_!=power||sliderPower_!=sliderPower||
+           radius_!=geometry.validRadius) {
+            reset();owner_=f.owner;lastMap_=f.map;lastRaw_=f.input;lastPlanned_=planned;target_=target;body_=currentBody;
+            intensity_=intensity;power_=power;sliderPower_=sliderPower;radius_=geometry.validRadius;
+            return budget_.process(f,planned,intensity);
+        }
+        // Max remains the only target owner. Never run another target selector
+        // or retain the previous target's fine offset after a handoff.
+        // Do not interpolate between two different objects (or a slider head
+        // and its body): that would introduce a callback-sized stale-target lag.
+        if(target_!=target||body_!=currentBody){fine_=Point();target_=target;body_=currentBody;lastPlanned_=planned;}
+        const auto elapsed=f.map-lastMap_;
+        if(elapsed==0)return budget_.process(f,planned,intensity);
+        const double strength=(power>1?.7+(power-1)*.15:power*.7)*(intensity/.5);
+        Point out=f.input;
+        for(std::int64_t ms=1;ms<=elapsed;ms++){
+            Frame sample=f;sample.map=lastMap_+ms;
+            sample.input=mix(lastRaw_,f.input,double(ms)/elapsed);
+            const Point before=mix(lastRaw_,f.input,double(ms-1)/elapsed);
+            const double moving=length(sub(sample.input,before));
+            const Point coarse=mix(lastPlanned_,planned,double(ms)/elapsed);
+            const Object object=objects.atTime(target,sample.map);
+            const bool body=object.kind==Kind::Slider&&object.headHandled&&sample.map>=object.start&&sample.map<=object.end;
+            const Point aim=body?object.path:object.head;
+            const double fov=std::max(1.2,4*strength)*geometry.validRadius;
+            if(!finite(aim)){reset();return f.input;}
+            // A sub-nanounit tolerance keeps interpolated observations on the
+            // exact FOV edge from engaging a different millisecond by rounding.
+            if(power==0||moving<.001||object.kind==Kind::Spinner||distance2(sample.input,aim)>fov*fov+1e-9){
+                fine_=mul(fine_,1-.6*std::min(1.,strength));
+                if(power==0||length(fine_)<1e-9)fine_=Point();
+            }else{
+                const Point difference=sub(aim,add(coarse,fine_));const double distance=length(difference);
