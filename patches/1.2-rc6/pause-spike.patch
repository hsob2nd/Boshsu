+        internal Stream GetFileStream(string filename)
+        {
+            // Online metadata and optional audio/artwork may have no backing
+            // local filename. Match the ordinary missing-file result before
+            // attempting a filesystem or package lookup.
+            if (string.IsNullOrEmpty(filename)) return null;
+            try
+            {
+                if (Package == null)
+                {
+                    filename = Path.Combine(ContainingFolderAbsolute, filename);
+
+                    if (!File.Exists(filename)) return null;
+
+                    return File.OpenRead(filename);
+                }
+
+                if (HasFileOverride(filename))
+                    return File.OpenRead(Path.Combine(ExtractionFolder, filename));
+
+                return Package.GetFile(filename);
+            }
+            catch (Exception e)
+            {
+                Logger.Log($"{filename} could not be loaded.\n{e}");
+                return null;
+            }
+        }
+
+        internal byte[] GetFileBytes(string filename)
+        {
+            byte[] data = null;
+            if (Package != null && !Package.AcquireLock(1, false))
+                return null;
+            try
+            {
+                using (Stream stream = GetFileStream(filename))
+                {
+                    if (stream != null)
+                    {
+                        data = new byte[stream.Length];
+                        stream.Read(data, 0, data.Length);
+                        stream.Close();
+                    }
+
+                }
+            }
+            finally
+            {
+                if (Package != null)
+                    Package.Unlock();
+            }
+
+            return data;
+        }
