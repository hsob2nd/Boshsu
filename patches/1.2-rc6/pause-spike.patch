+using System;
+namespace StableRemastered.Gameplay
+{
+    public static class FrameStallPolicy
+    {
+        // Frame pacing intentionally waits. Keep actual wall time for FPS,
+        // but don't label the limiter's own wait as an application stall.
+        public static bool ShouldReport(double elapsed,double intentionalSleep,double threshold)
+        {
+            return !double.IsNaN(elapsed)&&!double.IsInfinity(elapsed)&&elapsed>=0&&
+                !double.IsNaN(intentionalSleep)&&!double.IsInfinity(intentionalSleep)&&
+                Math.Max(0,elapsed-Math.Max(0,intentionalSleep))>threshold;
+        }
+    }
+}
