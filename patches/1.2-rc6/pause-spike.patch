+        internal bool RequiresDifficultyUpdate(PlayModes mode)
+        {
+            if (mode != PlayMode)
+                return false;
+            
+            if (!TomStars[(int)mode].ContainsKey(0))
+            {
+                return !computeInProgress;
+            }
+            if (TomStars[(int)mode][0] >= 0)
+            {
+                return false;
+            }
+            return TomStars[(int)mode][0] < 0.0;
+        }
