+            if (Package == null || HasFileOverride(AudioFilename))
+                return GetFileBytes(AudioFilename);
+
+            using (Stream stream = Package.GetFile(AudioFilename))
+            {
+                if (stream == null)
+                {
+                    AudioPresent = false;
+                    return null;
+                }
+
+                byte[] data = new byte[stream.Length];
+                stream.Read(data, 0, data.Length);
+                stream.Close();
+
+                return data;
+            }
