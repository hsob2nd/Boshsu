+        bool checkedForPackage;
+
+        internal MapPackage Package
+        {
+            get
+            {
+                if (!InOszContainer)
+                    return null;
+
+                if (!checkedForPackage && _package != null) return _package;
+
+                MapPackage package = Osz2Factory.TryOpen(ContainingFolderAbsolute);
+
+                if (_package != null || checkedForPackage)
+                {
+                    _package = package;
+                    return package;
+                }
+
+                if (package == null)
+                {
+                    string name = ContainingFolderAbsolute.Replace(".osz2", "") + ".osz2";
+                    if (File.Exists(name))
+                    {
+                        package = Osz2Factory.TryOpen(name);
+                        if (package == null)
