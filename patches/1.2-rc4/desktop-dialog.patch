+        static int ExceptionCount;
+
+        protected override void Draw()
+        {
+#if !DEBUG
+            try
+            {
+#endif
+            PerformanceMonitor.BeginCollecting(FrameTimeType.Draw);
+
+            StableRemastered.Application.ApplicationServices.Gameplay?.EndUpdate();
+            // Loading owns no presentable gameplay frame yet. Keep the last
+            // completed shell front buffer instead of clearing/swapping an empty
+            // Play screen. Native updates/resource preparation continue normally.
+            if(StableRemastered.Application.ApplicationServices.WaitingForGameplayFrame){
+                PerformanceMonitor.EndCollecting(FrameTimeType.Draw);return;
+            }
+            // Preserve real driver synchronization. Software render pacing is
+            // not equivalent to VSync; its swap wait remains a qualification
+            // limit while update and presentation share this owner thread.
+            bool nativeVsync=ConfigManager.sFrameSync==FrameSync.VSync;
+            if(GlControl.VSync!=nativeVsync)GlControl.VSync=nativeVsync;
+            if (StableRemastered.Application.ApplicationServices.RenderGameplay()) {
+                StableRemastered.Application.Shell.ShellTelemetry.Suspend();
+                if(StableRemastered.Application.ApplicationServices.GameplayFrameRendered){
+                    StableRemastered.Application.ApplicationServices.Gameplay.BeginSwap();
+                    GlControl.SwapBuffers();
+                    StableRemastered.Application.ApplicationServices.Gameplay.EndSwap();
+                    TotalFramesRendered++;
+                }
+                PerformanceMonitor.EndCollecting(FrameTimeType.Draw);
+                return;
+            }
+            bool nativePauseBackground = StableRemastered.Application.ApplicationServices.RenderPausedGameplay();
+            OsuGlControl.RestoreApplicationState();
+            GraphicsScheduler.Update();
+            TextureGl.UploadNext();
+
+            if (IsMinimized && CanRunSlowly && TotalFramesRendered % 4 != 0)
+            {
+                //We don't need to draw much when minimised.
+                //We do need to draw occasionally though, else there can be cases where, for example,
+                //Update creates many sprites which are never cleaned up by SpriteManager's Draw call.
+                //Once every 4 frames sounds like a fair compromise (once every second, as we run 15fps when minimised).
+                PerformanceMonitor.EndCollecting(FrameTimeType.Draw);
+                return;
+            }
+
+            SpriteManager.NewFrame();
+            Shader.SetGlobalProperty(@"g_Time", Time);
+
+            OsuGlControl.TextureShader2D.Begin();
+
+            HitObjectManager.DrawTargets();
+
+            if(!nativePauseBackground) GL.Clear(ClearBufferMask.ColorBufferBit);
+
+            bool replayCursor = InputManager.ReplayMode && Mode == OsuModes.Play;
+
+            //Begin bloom virtual renderer.
+            if (ConfigManager.sShaders) BloomRenderer.BloomStart();
+
+            if(!nativePauseBackground) TransitionManager.Draw();
+
+            base.Draw();
+
+            Components.ForEach(c => (c as DrawableGameComponent)?.Draw());
+
+
+            spriteManager.Draw();
+
+            //if ((BanchoClient.Permission & Permissions.Supporter) > 0)
+            if (replayCursor)
+            {
+                cursorTrailRenderer.Draw();
+                spriteManagerCursor.Draw();
+            }
+
+            Options.Draw();
+
+            osuDirect.Draw();
+
+            spriteManagerOverlay.Draw();
+            chatEngine.Draw();
+
+            MusicControl.Draw();
+
+            if (Coins != null) Coins.Draw();
+
+            if (ActiveDialog != null)
+                ActiveDialog.Draw();
+
+            StableRemastered.Application.Shell.ShellTelemetry.Frame();
+            StableRemastered.Application.Shell.ShellNotifications.Draw();
+            StableRemastered.Application.Shell.ShellStatsOverlay.Draw();
+
+            Volume.Draw();
+
+            if (FrameTimeDisplay != null && ConfigManager.sFrameTimeDisplay.Value && (!StableRemastered.Application.ApplicationServices.PortableHost || StableRemastered.Application.ApplicationServices.DeveloperToolsEnabled)) FrameTimeDisplay.Draw();
+
+            spriteManagerOverlayHighest.Draw();
+
+            FpsDisplay.Draw();
+
+            BanchoStatus.Draw();
+
+            if (OnScreenDisplay != null && (!StableRemastered.Application.ApplicationServices.PortableHost || StableRemastered.Application.ApplicationServices.DeveloperToolsEnabled)) OnScreenDisplay.Draw();
+
+            if (!replayCursor)
+            {
+                cursorTrailRenderer.Draw();
+                spriteManagerCursor.Draw();
+            }
+
+            spriteManagerHighest.Draw();
+
+            if (FadeState != FadeStates.Idle || spriteManagerTransition.Alpha > 0)
+                spriteManagerTransition.Draw();
+
+            TransitionManager.DrawHigh();
+
+            //Draw bloom overlay.
+            if (ConfigManager.sShaders) BloomRenderer.BloomEnd();
+
+            OsuGlControl.TextureShader2D.End();
+
+            PerformanceMonitor.EndCollecting(FrameTimeType.Draw);
+
+            PerformanceMonitor.BeginCollecting(FrameTimeType.Sleep);
+            Thread.Sleep(0);
+            PerformanceMonitor.EndCollecting(FrameTimeType.Sleep);
+
+            PerformanceMonitor.BeginCollecting(FrameTimeType.SwapBuffer);
+            GlControl.SwapBuffers();
+            PerformanceMonitor.EndCollecting(FrameTimeType.SwapBuffer);
+
+#if !DEBUG
+            }
+            catch (Exception e)
+            {
+                if (ExceptionCount++ > 1 || Mode == OsuModes.Exit || QueuedMode == OsuModes.Exit)
+                    throw;
+                softHandle(e);
+            }
+#endif
+
+            TotalFramesRendered++;
+        }
+
+        protected override void PostFrame()
+        {
+            PerformanceMonitor.BeginCollecting(FrameTimeType.Update);
+
+            base.PostFrame();
+
+            UpdateTiming();
+
+            PerformanceMonitor.EndCollecting(FrameTimeType.Update);
+
+            if (ConfigManager.sFrameTimeDisplay)
+            {
+                if (FrameTimeDisplay == null) FrameTimeDisplay = new FrameTimeDisplay(PerformanceMonitor);
+                if (!StableRemastered.Application.ApplicationServices.PortableHost || StableRemastered.Application.ApplicationServices.DeveloperToolsEnabled) FrameTimeDisplay.Update();
+            }
+
+            PerformanceMonitor.NewFrame();
+
+            PerformanceMonitor.BeginCollecting(FrameTimeType.BetweenFrames);
+            StableRemastered.Application.ApplicationServices.Gameplay?.EndFrame(!IsActive || IsMinimized);
+        }
