-        private static bool TryXdgOpen(string windowsPath)
-        {
-            if (string.IsNullOrEmpty(windowsPath))
-                return false;
-
-            try
-            {
-                string unixPath = WindowsPathToUnix(windowsPath);
-                if (string.IsNullOrEmpty(unixPath))
-                    return false;
-
-                // Escape single quotes in the path for safe shell embedding
-                string escapedPath = unixPath.Replace("'", "'\\''");
-
-                Process.Start(new ProcessStartInfo
-                {
-                    FileName = "/bin/sh",
-                    Arguments = $"-c \"xdg-open '{escapedPath}'\"",
-                    UseShellExecute = false
-                });
-                return true;
-            }
-            catch (Exception e)
-            {
-                Logger.Log($"TryXdgOpen failed: {e}", LoggingTarget.Runtime);
-                return false;
-            }
-        }
