+        public static void OpenFolderToFile(string filePath)
+        {
+            if (string.IsNullOrEmpty(filePath))
+                return;
+
+            string fullPath;
+            try
+            {
+                fullPath = Path.GetFullPath(filePath);
+            }
+            catch
+            {
+                return; // path itself is invalid, nothing we can do
+            }
+
+            string directory = Path.GetDirectoryName(fullPath);
+
+            // Wine builds: skip ShellExecuteEx entirely, go straight to xdg-open
+            if (OsuMain.IsWine)
+            {
+                if (TryXdgOpen(fullPath))
+                    return;
+
+                if (TryXdgOpen(directory))
+                    return;
+            }
+            else
+            {
+                // Native Windows path
+                if (TrySelectInExplorer(fullPath))
+                    return;
+
+                if (TryExplorerSelect(fullPath))
+                    return;
+
+                if (TryOpenFolder(directory))
+                    return;
+            }
+
+            // Attempt 4: give up gracefully, notify instead of crashing
+            Logger.Log($"OpenFolderToFile: all methods failed for '{fullPath}'", LoggingTarget.Runtime);
+            NotificationManager.ShowMessage("Couldn't open the folder automatically. It's at:\n" + fullPath);
+        }
