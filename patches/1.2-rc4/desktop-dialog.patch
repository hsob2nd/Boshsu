--- a/stable-remastered/application/DesktopFilePicker.cs
+++ b/stable-remastered/application/DesktopFilePicker.cs
@@ -0,0 +1,64 @@
+using System;
+using System.Windows.Forms;
+using osu;
+using osu.Input;
+using osu.Input.Handlers;
+
+namespace StableRemastered.Application
+{
+    // A Windows picker temporarily owns this UI thread and its pointer. It does
+    // not change the player's fullscreen, Raw Input or sensitivity preferences.
+    internal static class DesktopFilePicker
+    {
+        private static int depth;
+        internal static bool IsOpen => depth != 0;
+
+        internal static DialogResult Show(CommonDialog picker)
+        {
+            if(picker==null)throw new ArgumentNullException(nameof(picker));
+            return Run(owner=>picker.ShowDialog(owner));
+        }
+
+        internal static T Run<T>(Func<IWin32Window,T> show)
+        {
+            if(show==null)throw new ArgumentNullException(nameof(show));
+            Form owner=GameBase.Form;
+            if(owner==null || owner.IsDisposed)throw new InvalidOperationException("The client window is unavailable.");
+            if(owner.InvokeRequired)throw new InvalidOperationException("Open file pickers on the application's UI thread.");
+            bool outer=depth++==0;
+            try
+            {
+                if(outer)
+                {
+                    owner.TopMost=false;
+                    owner.Capture=false;
+                    InputManager.ReleaseCursor();
+                    InputManager.ClearMenuKeys();
+                    MouseManager.ResetStatus();
+                    ApplicationServices.SetFocus(false,false);
+                    MouseManager.UpdateMouseCursorVisibility();
+                    (ApplicationServices.Gameplay as McOsuGameplayEngine)?.SetPointerVisibility(true);
+                }
+                return show(owner);
+            }
+            finally
+            {
+                depth--;
+                if(outer && !owner.IsDisposed && !ApplicationServices.IsShuttingDown)
+                {
+                    InputManager.ClearMenuKeys();
+                    MouseManager.ResetStatus();
+                    bool minimized=owner.WindowState==FormWindowState.Minimized;
+                    bool focused=owner.ContainsFocus && !minimized;
+                    GameBase.Instance.IsActive=focused;
+                    ApplicationServices.SetFocus(focused,minimized);
+                    MouseManager.SetPosition(MouseManager.GetNativePosition());
+                    MouseManager.UpdateMouseCursorVisibility();
+                    (ApplicationServices.Gameplay as McOsuGameplayEngine)?.SetPointerVisibility(GameBase.MouseVisible);
+                    InputManager.UpdateShallClampMouseToWindow();
+                    owner.TopMost=GameBase.TopMost;
+                }
+            }
+        }
+    }
+}
