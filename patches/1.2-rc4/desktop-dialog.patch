+            catch
+            {
+            }
+#if P2P
+            Osup2pManager.Shutdown();
+#endif
+
+            try
+            {
+                Bass.BASS_Free();
+            }
+            catch { }
+
+            InputManager.Dispose();
+
+            base.OnExiting(sender, args);
